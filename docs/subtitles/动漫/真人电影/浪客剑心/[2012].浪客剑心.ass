Dialogue: 0,0:00:19.15,0:00:25.60,*Default,,0,0,0,,距今140年前,在动乱的幕府末期
Dialogue: 0,0:00:27.15,0:00:33.48,*Default,,0,0,0,,有一名被称为"刽子手拔刀斋"的暗杀刺客
Dialogue: 0,0:00:35.24,0:00:40.14,*Default,,0,0,0,,奉倒幕派之命,潜伏于京都
Dialogue: 0,0:00:40.15,0:00:45.07,*Default,,0,0,0,,其如修罗般的身手和冷酷令人生畏
Dialogue: 0,0:00:47.72,0:00:54.34,*Default,,0,0,0,,时值一分天下的戊辰之战
Dialogue: 0,0:01:19.90,0:01:25.25,*Default,,0,0,0,,一八六八年一月,京都鸟羽伏见的山中
Dialogue: 0,0:01:48.67,0:01:51.46,*Default,,0,0,0,,找到了,是新撰组
Dialogue: 0,0:02:01.71,0:02:03.50,*Default,,0,0,0,,刽子手拔刀斋
Dialogue: 0,0:02:04.39,0:02:07.14,*Default,,0,0,0,,你在哪里,究竟在哪里?
Dialogue: 0,0:02:19.75,0:02:23.06,*Default,,0,0,0,,新撰组第三组组长斋藤一,受死吧!
Dialogue: 0,0:02:49.55,0:02:51.10,*Default,,0,0,0,,一决胜负吧,拔刀斋
Dialogue: 0,0:03:47.71,0:03:52.14,*Default,,0,0,0,,赢了,那是锦旗!
Dialogue: 0,0:03:53.19,0:03:56.22,*Default,,0,0,0,,如此一来,你们就是叛军了
Dialogue: 0,0:04:01.03,0:04:03.70,*Default,,0,0,0,,赢的是我们萨长军!
Dialogue: 0,0:04:11.91,0:04:13.02,*Default,,0,0,0,,新时代
Dialogue: 0,0:04:14.87,0:04:16.46,*Default,,0,0,0,,到来了么?
Dialogue: 0,0:04:23.23,0:04:24.62,*Default,,0,0,0,,终于来了
Dialogue: 0,0:04:33.83,0:04:35.14,*Default,,0,0,0,,绯村拔刀斋
Dialogue: 0,0:04:48.55,0:04:50.46,*Default,,0,0,0,,别以为就此结束了
Dialogue: 0,0:04:51.59,0:04:54.02,*Default,,0,0,0,,无论世间如何变化
Dialogue: 0,0:04:54.63,0:04:55.74,*Default,,0,0,0,,仗剑生
Dialogue: 0,0:04:56.67,0:04:59.74,*Default,,0,0,0,,为剑死,这是我们唯一的路
Dialogue: 0,0:06:02.07,0:06:03.62,*Default,,0,0,0,,为什么
Dialogue: 0,0:06:06.15,0:06:08.61,*Default,,0,0,0,,为什么我活下来了
Dialogue: 0,0:06:33.11,0:06:35.67,*Default,,0,0,0,,这把刀怎么回事?
Dialogue: 0,0:07:00.39,0:07:03.10,*Default,,0,0,0,,这是侩子手拔刀斋的刀
Dialogue: 0,0:07:07.00,0:07:15.80,*Default,,0,0,0,,《浪客剑心》
Dialogue: 0,0:07:32.06,0:07:35.27,*Default,,0,0,0,,一八七八年,明治十一年
Dialogue: 0,0:07:35.27,0:07:40.03,*Default,,0,0,0,,一八七八年,明治十一年,东京
Dialogue: 0,0:07:40.03,0:07:42.90,*Default,,0,0,0,,陆军卿山县有话要说
Dialogue: 0,0:07:45.15,0:07:46.18,*Default,,0,0,0,,敬礼
Dialogue: 0,0:07:51.79,0:07:52.46,*Default,,0,0,0,,稍息
Dialogue: 0,0:07:54.43,0:07:56.38,*Default,,0,0,0,,明治维新后十年
Dialogue: 0,0:07:56.99,0:08:01.26,*Default,,0,0,0,,举国上下,万众一心,学习西欧各国
Dialogue: 0,0:08:01.71,0:08:04.09,*Default,,0,0,0,,向前迈出了崭新的步伐
Dialogue: 0,0:08:08.27,0:08:13.39,*Default,,0,0,0,,现今,新政府的威望泽被全国
Dialogue: 0,0:08:14.43,0:08:19.34,*Default,,0,0,0,,为我国带来了幸福与安宁
Dialogue: 0,0:08:25.75,0:08:31.98,*Default,,0,0,0,,恐怖与暴力的时代已经结束了
Dialogue: 0,0:08:32.67,0:08:33.46,*Default,,0,0,0,,敬礼
Dialogue: 0,0:08:45.15,0:08:48.30,*Default,,0,0,0,,人类是懦弱的
Dialogue: 0,0:08:49.75,0:08:53.45,*Default,,0,0,0,,嘴上爱讲理想
Dialogue: 0,0:08:53.91,0:08:59.34,*Default,,0,0,0,,但在三样东西面前会变成野兽
Dialogue: 0,0:09:01.87,0:09:03.50,*Default,,0,0,0,,自我
Dialogue: 0,0:09:04.43,0:09:06.30,*Default,,0,0,0,,金钱
Dialogue: 0,0:09:08.35,0:09:11.38,*Default,,0,0,0,,享乐
Dialogue: 0,0:09:19.83,0:09:21.05,*Default,,0,0,0,,打扰了
Dialogue: 0,0:09:26.83,0:09:31.90,*Default,,0,0,0,,成功了,惠,干得好
Dialogue: 0,0:09:32.39,0:09:34.30,*Default,,0,0,0,,谢谢夸奖
Dialogue: 0,0:09:34.43,0:09:37.34,*Default,,0,0,0,,这种新型鸦片
Dialogue: 0,0:09:38.19,0:09:41.86,*Default,,0,0,0,,能把人变成野兽
Dialogue: 0,0:09:42.03,0:09:43.34,*Default,,0,0,0,,退下吧
Dialogue: 0,0:11:13.63,0:11:17.58,*Default,,0,0,0,,知道制作方法的人,留下一个就够了
Dialogue: 0,0:11:19.23,0:11:23.18,*Default,,0,0,0,,留下谁呢
Dialogue: 0,0:11:24.03,0:11:32.66,*Default,,0,0,0,,全听神的
Dialogue: 0,0:11:33.91,0:11:34.94,*Default,,0,0,0,,指示
Dialogue: 0,0:11:38.47,0:11:40.02,*Default,,0,0,0,,谢谢您
Dialogue: 0,0:12:12.67,0:12:13.98,*Default,,0,0,0,,混蛋!
Dialogue: 0,0:12:21.79,0:12:23.26,*Default,,0,0,0,,快追
Dialogue: 0,0:12:23.67,0:12:25.02,*Default,,0,0,0,,让他去吧
Dialogue: 0,0:12:27.39,0:12:28.66,*Default,,0,0,0,,那个人
Dialogue: 0,0:12:30.35,0:12:33.18,*Default,,0,0,0,,就交给拔刀斋处置吧
Dialogue: 0,0:13:18.63,0:13:22.06,*Default,,0,0,0,,要来串美味的烤丸子么?
Dialogue: 0,0:13:22.23,0:13:24.06,*Default,,0,0,0,,- 在下要一串  - 好的,欢迎光临
Dialogue: 0,0:13:27.79,0:13:29.62,*Default,,0,0,0,,听不懂么?
Dialogue: 0,0:13:29.79,0:13:31.38,*Default,,0,0,0,,不是叫你们后退么?
Dialogue: 0,0:13:31.67,0:13:34.30,*Default,,0,0,0,,往后退,听见没,听不懂啊?
Dialogue: 0,0:13:37.67,0:13:40.42,*Default,,0,0,0,,是在做卧底的警察
Dialogue: 0,0:13:44.39,0:13:45.45,*Default,,0,0,0,,杀鸡儆猴啊
Dialogue: 0,0:13:46.75,0:13:51.26,*Default,,0,0,0,,又是侩子手拔刀斋,为什么总是要留下除奸状?
Dialogue: 0,0:13:52.59,0:13:53.73,*Default,,0,0,0,,不是他
Dialogue: 0,0:13:56.43,0:14:00.70,*Default,,0,0,0,,除奸状上会写死者的罪行
Dialogue: 0,0:14:02.39,0:14:03.45,*Default,,0,0,0,,那是谁...
Dialogue: 0,0:14:04.11,0:14:06.49,*Default,,0,0,0,,这不是拔刀斋的手法
Dialogue: 0,0:14:23.47,0:14:25.46,*Default,,0,0,0,,侩子手拔刀斋
Dialogue: 0,0:14:27.47,0:14:31.06,*Default,,0,0,0,,神谷活心流?
Dialogue: 0,0:14:32.63,0:14:33.82,*Default,,0,0,0,,喂,你!
Dialogue: 0,0:14:36.23,0:14:39.58,*Default,,0,0,0,,无视废刀令,带着刀到处乱晃
Dialogue: 0,0:14:40.35,0:14:42.65,*Default,,0,0,0,,你就是那个侩子手拔刀斋么?
Dialogue: 0,0:14:43.99,0:14:47.30,*Default,,0,0,0,,你的恶行到此为止,受死吧
Dialogue: 0,0:14:47.47,0:14:50.38,*Default,,0,0,0,,等等,请等一下
Dialogue: 0,0:14:50.91,0:14:51.97,*Default,,0,0,0,,少废话!
Dialogue: 0,0:14:55.31,0:14:56.66,*Default,,0,0,0,,您误会了
Dialogue: 0,0:15:16.19,0:15:18.49,*Default,,0,0,0,,在下是浪客
Dialogue: 0,0:15:20.19,0:15:23.18,*Default,,0,0,0,,只是个浪迹天涯的剑客
Dialogue: 0,0:15:30.19,0:15:32.49,*Default,,0,0,0,,您明白了么
Dialogue: 0,0:15:33.67,0:15:36.30,*Default,,0,0,0,,那你为什么带刀?
Dialogue: 0,0:15:38.31,0:15:40.66,*Default,,0,0,0,,此为逆刃刀
Dialogue: 0,0:15:41.71,0:15:43.34,*Default,,0,0,0,,逆刃刀?
Dialogue: 0,0:15:43.51,0:15:44.54,*Default,,0,0,0,,像这样
Dialogue: 0,0:15:48.39,0:15:50.22,*Default,,0,0,0,,刀锋在里
Dialogue: 0,0:15:51.39,0:15:53.74,*Default,,0,0,0,,与一般的刀相反吧?
Dialogue: 0,0:16:01.19,0:16:03.75,*Default,,0,0,0,,这样就不能砍人了
Dialogue: 0,0:16:04.55,0:16:05.94,*Default,,0,0,0,,是吧?
Dialogue: 0,0:16:15.71,0:16:16.93,*Default,,0,0,0,,不胜感激
Dialogue: 0,0:16:23.83,0:16:26.21,*Default,,0,0,0,,对了,那幅画像是...
Dialogue: 0,0:16:30.35,0:16:31.74,*Default,,0,0,0,,大约半年前
Dialogue: 0,0:16:32.87,0:16:36.94,*Default,,0,0,0,,有人打着我们流派的名号杀人,并留下除奸状
Dialogue: 0,0:16:37.71,0:16:39.82,*Default,,0,0,0,,时代明明已经变了
Dialogue: 0,0:17:11.55,0:17:13.06,*Default,,0,0,0,,观柳大人
Dialogue: 0,0:17:20.39,0:17:22.38,*Default,,0,0,0,,有客来访
Dialogue: 0,0:17:36.23,0:17:42.42,*Default,,0,0,0,,我还以为你们警察,都喜欢前前后后结伴而来呢
Dialogue: 0,0:17:44.07,0:17:46.30,*Default,,0,0,0,,要来一块么?
Dialogue: 0,0:17:53.31,0:17:55.06,*Default,,0,0,0,,这又是什么呢?
Dialogue: 0,0:17:55.27,0:17:59.82,*Default,,0,0,0,,正在执行卧底调查的警察被杀了,凶手自称拔刀斋
Dialogue: 0,0:18:01.59,0:18:04.12,*Default,,0,0,0,,你是说十年后的今天
Dialogue: 0,0:18:04.39,0:18:07.62,*Default,,0,0,0,,武士的亡灵作为杀人狂重现了么?
Dialogue: 0,0:18:07.79,0:18:09.78,*Default,,0,0,0,,你将新桥的仓库做了何用?
Dialogue: 0,0:18:09.91,0:18:10.78,*Default,,0,0,0,,仓库?
Dialogue: 0,0:18:11.07,0:18:13.78,*Default,,0,0,0,,那个仓库现在闲置着
Dialogue: 0,0:18:14.11,0:18:16.74,*Default,,0,0,0,,本想用来放进口商品的
Dialogue: 0,0:18:16.83,0:18:18.94,*Default,,0,0,0,,但又觉得稍有不妥
Dialogue: 0,0:18:19.23,0:18:21.61,*Default,,0,0,0,,一定要调查的话
Dialogue: 0,0:18:22.31,0:18:24.42,*Default,,0,0,0,,请按正规的步骤来
Dialogue: 0,0:18:24.79,0:18:28.57,*Default,,0,0,0,,即使你这样的大人物,也不能为所欲为
Dialogue: 0,0:18:29.11,0:18:30.46,*Default,,0,0,0,,这就是新时代啊
Dialogue: 0,0:18:36.83,0:18:39.13,*Default,,0,0,0,,少得意
Dialogue: 0,0:18:40.83,0:18:45.30,*Default,,0,0,0,,那位武士亡灵似乎还未察觉时代的变迁
Dialogue: 0,0:18:48.79,0:18:50.18,*Default,,0,0,0,,开饭啦!
Dialogue: 0,0:19:03.31,0:19:05.54,*Default,,0,0,0,,看看那些人
Dialogue: 0,0:19:06.35,0:19:11.34,*Default,,0,0,0,,都是些进入明治后无处谋生的原士族、武士和浪人
Dialogue: 0,0:19:11.51,0:19:12.65,*Default,,0,0,0,,我实在看不下去了
Dialogue: 0,0:19:12.79,0:19:14.86,*Default,,0,0,0,,便雇他们当护卫,像这样养着他们
Dialogue: 0,0:19:15.03,0:19:19.50,*Default,,0,0,0,,他们都是些有本事的人,放任不管会出乱子的
Dialogue: 0,0:19:20.35,0:19:23.82,*Default,,0,0,0,,饿极了的狗可是什么都会咬的
Dialogue: 0,0:19:32.71,0:19:37.70,*Default,,0,0,0,,看起来,您原本也是武士吧
Dialogue: 0,0:19:38.19,0:19:38.90,*Default,,0,0,0,,现在也是
Dialogue: 0,0:19:39.19,0:19:40.98,*Default,,0,0,0,,怪不得话不投机
Dialogue: 0,0:19:41.23,0:19:42.50,*Default,,0,0,0,,小心点
Dialogue: 0,0:19:43.71,0:19:47.38,*Default,,0,0,0,,警察们重视证据,我可不同
Dialogue: 0,0:19:58.27,0:20:00.42,*Default,,0,0,0,,观柳大人,惠逃走了
Dialogue: 0,0:20:05.35,0:20:07.91,*Default,,0,0,0,,你说什么,惠逃走了?
Dialogue: 0,0:20:08.91,0:20:12.22,*Default,,0,0,0,,被我们收买的警察提供的情报
Dialogue: 0,0:20:13.23,0:20:16.54,*Default,,0,0,0,,说有个女人跑到警察局去了
Dialogue: 0,0:20:31.23,0:20:32.42,*Default,,0,0,0,,可恶!
Dialogue: 0,0:20:34.43,0:20:37.30,*Default,,0,0,0,,不必担心
Dialogue: 0,0:20:37.55,0:20:41.58,*Default,,0,0,0,,要是把鸦片的事说出来,她也会被问罪的
Dialogue: 0,0:20:41.75,0:20:43.26,*Default,,0,0,0,,老哥,你太傻了
Dialogue: 0,0:20:43.55,0:20:46.90,*Default,,0,0,0,,女人要是不要命了,可是什么都干得出来
Dialogue: 0,0:20:47.59,0:20:49.62,*Default,,0,0,0,,你们懂女人么?
Dialogue: 0,0:20:50.39,0:20:51.06,*Default,,0,0,0,,你说什么?
Dialogue: 0,0:20:51.15,0:20:52.42,*Default,,0,0,0,,你想干嘛?
Dialogue: 0,0:20:53.79,0:20:54.90,*Default,,0,0,0,,闭嘴!
Dialogue: 0,0:20:58.07,0:21:01.94,*Default,,0,0,0,,立刻把那女人带回来!
Dialogue: 0,0:21:05.75,0:21:06.81,*Default,,0,0,0,,别碰我
Dialogue: 0,0:21:07.07,0:21:08.13,*Default,,0,0,0,,你说什么呢?
Dialogue: 0,0:21:10.07,0:21:11.05,*Default,,0,0,0,,我去收拾
Dialogue: 0,0:21:16.51,0:21:18.46,*Default,,0,0,0,,留活口,刃卫
Dialogue: 0,0:21:19.99,0:21:24.78,*Default,,0,0,0,,那个女人知道"蜘蛛网"的精制法
Dialogue: 0,0:21:27.63,0:21:32.82,*Default,,0,0,0,,事后任你处置,拔刀斋
Dialogue: 0,0:21:41.03,0:21:43.82,*Default,,0,0,0,,是你要我们保护你的吧?
Dialogue: 0,0:21:43.99,0:21:46.45,*Default,,0,0,0,,你得告诉我们发生什么了吧?
Dialogue: 0,0:21:50.99,0:21:52.66,*Default,,0,0,0,,真拿你没办法
Dialogue: 0,0:22:09.03,0:22:10.90,*Default,,0,0,0,,怎么了?
Dialogue: 0,0:22:12.75,0:22:13.97,*Default,,0,0,0,,那边!
Dialogue: 0,0:22:16.15,0:22:17.18,*Default,,0,0,0,,怎么啦
Dialogue: 0,0:22:17.35,0:22:18.86,*Default,,0,0,0,,让开!
Dialogue: 0,0:22:31.07,0:22:32.70,*Default,,0,0,0,,你就是拔刀斋么?
Dialogue: 0,0:22:32.91,0:22:33.97,*Default,,0,0,0,,放老实点
Dialogue: 0,0:22:52.43,0:22:53.90,*Default,,0,0,0,,什么人?
Dialogue: 0,0:22:54.27,0:22:55.54,*Default,,0,0,0,,别动
Dialogue: 0,0:22:56.07,0:22:57.10,*Default,,0,0,0,,不许动
Dialogue: 0,0:22:59.79,0:23:00.93,*Default,,0,0,0,,老实点
Dialogue: 0,0:23:32.63,0:23:34.90,*Default,,0,0,0,,这可不是妖术
Dialogue: 0,0:23:37.63,0:23:40.09,*Default,,0,0,0,,是二阶堂平法,心之一方
Dialogue: 0,0:23:40.43,0:23:42.62,*Default,,0,0,0,,人类在恐惧面前软弱无力
Dialogue: 0,0:23:42.91,0:23:48.10,*Default,,0,0,0,,触及那份软弱后威力渐长的剑气能让对方动弹不得
Dialogue: 0,0:23:50.63,0:23:51.77,*Default,,0,0,0,,痛苦么?
Dialogue: 0,0:23:54.11,0:23:57.46,*Default,,0,0,0,,内心越脆弱的人,越容易中招
Dialogue: 0,0:24:39.03,0:24:40.98,*Default,,0,0,0,,小猫
Dialogue: 0,0:24:44.67,0:24:46.38,*Default,,0,0,0,,小猫咪!
Dialogue: 0,0:25:07.15,0:25:08.13,*Default,,0,0,0,,喂
Dialogue: 0,0:25:19.99,0:25:21.02,*Default,,0,0,0,,站住!
Dialogue: 0,0:25:30.75,0:25:32.54,*Default,,0,0,0,,你就是拔刀斋么?
Dialogue: 0,0:25:35.75,0:25:37.06,*Default,,0,0,0,,你究竟是何目的
Dialogue: 0,0:25:37.43,0:25:41.21,*Default,,0,0,0,,打着我神谷活心流的名号干坏事?
Dialogue: 0,0:25:52.75,0:25:55.90,*Default,,0,0,0,,就是因为你这种败类,我父亲...
Dialogue: 0,0:25:56.07,0:25:59.69,*Default,,0,0,0,,父亲留下的神谷活心流才会...
Dialogue: 0,0:26:05.87,0:26:08.58,*Default,,0,0,0,,你说你父亲怎么了?
Dialogue: 0,0:26:09.27,0:26:11.42,*Default,,0,0,0,,父亲提倡活人剑
Dialogue: 0,0:26:12.27,0:26:15.58,*Default,,0,0,0,,既不砍人,也不杀人
Dialogue: 0,0:26:16.23,0:26:19.26,*Default,,0,0,0,,而是救人之剑
Dialogue: 0,0:26:24.11,0:26:27.62,*Default,,0,0,0,,一介女流仅凭一把木剑就想对抗我
Dialogue: 0,0:26:27.75,0:26:28.66,*Default,,0,0,0,,闭嘴!
Dialogue: 0,0:26:32.15,0:26:34.94,*Default,,0,0,0,,这种木棍能奈我何?
Dialogue: 0,0:26:40.83,0:26:43.94,*Default,,0,0,0,,饮过血的剑才是活剑
Dialogue: 0,0:26:48.31,0:26:49.98,*Default,,0,0,0,,去阴间觉悟吧
Dialogue: 0,0:26:58.63,0:27:00.62,*Default,,0,0,0,,您忘了东西
Dialogue: 0,0:27:02.83,0:27:04.14,*Default,,0,0,0,,你是谁?
Dialogue: 0,0:27:06.83,0:27:08.26,*Default,,0,0,0,,不必管在下是谁
Dialogue: 0,0:27:12.83,0:27:16.82,*Default,,0,0,0,,你就是那个自称拔刀斋的人么?
Dialogue: 0,0:27:23.35,0:27:25.14,*Default,,0,0,0,,那伤疤
Dialogue: 0,0:27:27.67,0:27:29.18,*Default,,0,0,0,,那速度
Dialogue: 0,0:27:35.55,0:27:37.66,*Default,,0,0,0,,你就是传说的...
Dialogue: 0,0:27:43.67,0:27:47.18,*Default,,0,0,0,,这招似乎对你不管用啊
Dialogue: 0,0:27:47.35,0:27:49.02,*Default,,0,0,0,,快逃
Dialogue: 0,0:27:50.71,0:27:52.30,*Default,,0,0,0,,这边!
Dialogue: 0,0:27:55.15,0:27:56.86,*Default,,0,0,0,,放老实点,拔刀斋
Dialogue: 0,0:27:56.95,0:27:59.70,*Default,,0,0,0,,总算有了在这无聊之世活下来的价值
Dialogue: 0,0:27:59.83,0:28:00.81,*Default,,0,0,0,,束手就擒吧
Dialogue: 0,0:28:05.67,0:28:07.22,*Default,,0,0,0,,你还好吗?
Dialogue: 0,0:28:12.91,0:28:15.37,*Default,,0,0,0,,找到拔刀斋了
Dialogue: 0,0:28:15.75,0:28:16.86,*Default,,0,0,0,,抓住他
Dialogue: 0,0:28:17.39,0:28:18.37,*Default,,0,0,0,,走那边
Dialogue: 0,0:28:19.07,0:28:19.66,*Default,,0,0,0,,这边!
Dialogue: 0,0:28:45.23,0:28:46.90,*Default,,0,0,0,,虽然要谢你
Dialogue: 0,0:28:48.63,0:28:52.90,*Default,,0,0,0,,但即便你不出手相救,我也不会有事的
Dialogue: 0,0:28:55.59,0:28:57.89,*Default,,0,0,0,,还是尽快处理下伤口为好
Dialogue: 0,0:29:25.95,0:29:30.10,*Default,,0,0,0,,代师傅,神谷熏
Dialogue: 0,0:29:32.11,0:29:35.30,*Default,,0,0,0,,虽然原本只是个小流派
Dialogue: 0,0:29:36.79,0:29:39.46,*Default,,0,0,0,,但许多人因仰慕先父
Dialogue: 0,0:29:40.51,0:29:43.14,*Default,,0,0,0,,纷纷到这里来练剑
Dialogue: 0,0:29:51.59,0:29:56.30,*Default,,0,0,0,,但由于半年前开始的拔刀斋骚动
Dialogue: 0,0:29:58.99,0:30:00.98,*Default,,0,0,0,,如今成了这番光景
Dialogue: 0,0:30:05.95,0:30:09.38,*Default,,0,0,0,,必须尽快阻止那人的恶行
Dialogue: 0,0:30:12.47,0:30:15.18,*Default,,0,0,0,,劝你还是作罢为好
Dialogue: 0,0:30:15.51,0:30:16.46,*Default,,0,0,0,,什么?
Dialogue: 0,0:30:16.83,0:30:20.34,*Default,,0,0,0,,那个人比熏小姐你厉害得多
Dialogue: 0,0:30:21.71,0:30:26.34,*Default,,0,0,0,,知己知彼,亦是剑客的重要素质之一
Dialogue: 0,0:30:27.03,0:30:30.14,*Default,,0,0,0,,下次交手的结果如何,你心中应该有数吧
Dialogue: 0,0:30:33.75,0:30:35.50,*Default,,0,0,0,,流派的荣誉
Dialogue: 0,0:30:36.99,0:30:40.02,*Default,,0,0,0,,还未沉重到要以性命去守护
Dialogue: 0,0:30:55.35,0:30:58.02,*Default,,0,0,0,,剑并非杀人工具
Dialogue: 0,0:31:02.23,0:31:06.34,*Default,,0,0,0,,真是伤心,以活人剑为理想的神谷活心流...
Dialogue: 0,0:31:08.59,0:31:11.05,*Default,,0,0,0,,竟被杀人剑所玷污
Dialogue: 0,0:31:21.87,0:31:24.25,*Default,,0,0,0,,你区区一介浪客
Dialogue: 0,0:31:26.07,0:31:28.06,*Default,,0,0,0,,怎会明白我有多不甘心!
Dialogue: 0,0:31:30.23,0:31:32.18,*Default,,0,0,0,,活人剑
Dialogue: 0,0:31:39.43,0:31:40.38,*Default,,0,0,0,,算了
Dialogue: 0,0:31:41.43,0:31:44.58,*Default,,0,0,0,,无论如何,你带着这伤也无法巡夜了
Dialogue: 0,0:31:50.59,0:31:52.42,*Default,,0,0,0,,你去世的父亲
Dialogue: 0,0:31:53.27,0:31:55.57,*Default,,0,0,0,,想必也不希望女儿,为了守护流派
Dialogue: 0,0:31:56.39,0:31:59.78,*Default,,0,0,0,,而赔上性命吧
Dialogue: 0,0:32:02.79,0:32:03.93,*Default,,0,0,0,,告辞了
Dialogue: 0,0:32:35.83,0:32:37.46,*Default,,0,0,0,,怎么会这样
Dialogue: 0,0:32:53.15,0:32:56.50,*Default,,0,0,0,,这是对我等的挑战么?
Dialogue: 0,0:33:30.35,0:33:31.49,*Default,,0,0,0,,是浪客么?
Dialogue: 0,0:33:35.87,0:33:37.06,*Default,,0,0,0,,是你啊
Dialogue: 0,0:33:37.59,0:33:38.86,*Default,,0,0,0,,什么叫"是你啊"?
Dialogue: 0,0:33:39.27,0:33:41.22,*Default,,0,0,0,,我明神弥彦大人来你不满意么?
Dialogue: 0,0:33:41.39,0:33:42.98,*Default,,0,0,0,,真吵啊
Dialogue: 0,0:33:43.39,0:33:45.50,*Default,,0,0,0,,给我早饭吃啊
Dialogue: 0,0:33:48.07,0:33:51.74,*Default,,0,0,0,,给饿着肚子的孤儿施舍一碗热饭
Dialogue: 0,0:33:52.03,0:33:53.06,*Default,,0,0,0,,你真烦
Dialogue: 0,0:33:53.15,0:33:54.90,*Default,,0,0,0,,先要练习才对吧?
Dialogue: 0,0:33:54.99,0:33:57.06,*Default,,0,0,0,,- 快收拾一下  - 什么嘛
Dialogue: 0,0:34:16.07,0:34:17.42,*Default,,0,0,0,,你们干什么?
Dialogue: 0,0:34:20.23,0:34:22.10,*Default,,0,0,0,,我们要收下这个道场
Dialogue: 0,0:34:22.59,0:34:23.70,*Default,,0,0,0,,你说什么?
Dialogue: 0,0:34:24.75,0:34:26.74,*Default,,0,0,0,,会给你开个好价钱的
Dialogue: 0,0:34:27.91,0:34:31.22,*Default,,0,0,0,,有位大人想高价买下这个道场
Dialogue: 0,0:34:31.79,0:34:33.22,*Default,,0,0,0,,对你也不是什么坏事
Dialogue: 0,0:34:33.31,0:34:34.74,*Default,,0,0,0,,对吧?
Dialogue: 0,0:34:35.11,0:34:36.09,*Default,,0,0,0,,你在说什么?
Dialogue: 0,0:34:36.23,0:34:38.30,*Default,,0,0,0,,我怎么可能轻易将父亲的道场卖给...
Dialogue: 0,0:34:38.43,0:34:40.26,*Default,,0,0,0,,代师傅啊!
Dialogue: 0,0:34:41.63,0:34:45.25,*Default,,0,0,0,,你还真是个厚脸皮的女人
Dialogue: 0,0:34:45.43,0:34:48.90,*Default,,0,0,0,,你家的流派都出杀人犯了
Dialogue: 0,0:34:49.27,0:34:51.14,*Default,,0,0,0,,拔刀斋跟我们无关!
Dialogue: 0,0:34:51.27,0:34:52.25,*Default,,0,0,0,,少嘴硬了
Dialogue: 0,0:34:52.75,0:34:54.82,*Default,,0,0,0,,如今没人会靠近
Dialogue: 0,0:34:55.47,0:34:57.10,*Default,,0,0,0,,这种刽子手的道场了吧
Dialogue: 0,0:34:57.79,0:34:58.77,*Default,,0,0,0,,动手!
Dialogue: 0,0:35:01.51,0:35:02.62,*Default,,0,0,0,,你们住手!
Dialogue: 0,0:35:02.79,0:35:03.77,*Default,,0,0,0,,住手!
Dialogue: 0,0:35:04.11,0:35:05.62,*Default,,0,0,0,,你们干什么!
Dialogue: 0,0:35:08.35,0:35:09.30,*Default,,0,0,0,,弥彦!
Dialogue: 0,0:35:12.43,0:35:13.46,*Default,,0,0,0,,这小鬼怎么回事?
Dialogue: 0,0:35:13.59,0:35:18.45,*Default,,0,0,0,,本人乃东京府士族明神弥彦,欺凌弱小不可饶恕
Dialogue: 0,0:35:19.31,0:35:20.58,*Default,,0,0,0,,放开那孩子
Dialogue: 0,0:35:22.79,0:35:24.14,*Default,,0,0,0,,你们干什么?
Dialogue: 0,0:35:24.31,0:35:27.10,*Default,,0,0,0,,等变强了再跟我说大话
Dialogue: 0,0:35:27.19,0:35:28.41,*Default,,0,0,0,,就是
Dialogue: 0,0:35:29.99,0:35:33.66,*Default,,0,0,0,,听说这个流派提倡活人剑
Dialogue: 0,0:35:34.51,0:35:38.82,*Default,,0,0,0,,那就先用那把剑救活自己试试吧
Dialogue: 0,0:35:45.35,0:35:46.66,*Default,,0,0,0,,不准穿鞋进去
Dialogue: 0,0:35:47.31,0:35:50.34,*Default,,0,0,0,,什么活人剑,真是太天真了
Dialogue: 0,0:35:51.31,0:35:52.66,*Default,,0,0,0,,不准穿鞋进去!
Dialogue: 0,0:35:52.79,0:35:55.82,*Default,,0,0,0,,目的是暴力,奥义为杀生
Dialogue: 0,0:35:56.55,0:35:59.18,*Default,,0,0,0,,这才是剑术的本质
Dialogue: 0,0:36:09.51,0:36:10.70,*Default,,0,0,0,,不可原谅
Dialogue: 0,0:36:14.83,0:36:16.34,*Default,,0,0,0,,怎么回事
Dialogue: 0,0:36:28.55,0:36:29.69,*Default,,0,0,0,,浪客
Dialogue: 0,0:36:30.39,0:36:31.37,*Default,,0,0,0,,滚开!
Dialogue: 0,0:36:33.27,0:36:34.33,*Default,,0,0,0,,你是何人?
Dialogue: 0,0:36:34.83,0:36:35.74,*Default,,0,0,0,,确实
Dialogue: 0,0:36:37.71,0:36:39.82,*Default,,0,0,0,,那位小姐所说的话
Dialogue: 0,0:36:40.39,0:36:43.70,*Default,,0,0,0,,是从未弄脏过自己双手的人才会说的
Dialogue: 0,0:36:44.75,0:36:47.02,*Default,,0,0,0,,天真的儿话
Dialogue: 0,0:36:49.19,0:36:50.54,*Default,,0,0,0,,剑是凶器
Dialogue: 0,0:36:51.39,0:36:53.22,*Default,,0,0,0,,剑术就是杀人伎俩
Dialogue: 0,0:36:54.27,0:36:57.89,*Default,,0,0,0,,无论用什么华丽的辞藻去粉饰,那始终是事实
Dialogue: 0,0:36:58.75,0:37:01.30,*Default,,0,0,0,,但比起这个事实
Dialogue: 0,0:37:02.30,0:37:07.30,*Default,,0,0,0,,在下还是更喜欢熏小姐所说的天真话
Dialogue: 0,0:37:11.27,0:37:12.30,*Default,,0,0,0,,真无聊!
Dialogue: 0,0:37:44.75,0:37:46.62,*Default,,0,0,0,,别退后啊,快上啊
Dialogue: 0,0:37:46.71,0:37:47.50,*Default,,0,0,0,,快上啊
Dialogue: 0,0:37:48.99,0:37:50.50,*Default,,0,0,0,,别退了,蠢货!
Dialogue: 0,0:37:50.83,0:37:52.26,*Default,,0,0,0,,叫你上啊!
Dialogue: 0,0:38:43.99,0:38:47.77,*Default,,0,0,0,,刽子手拔刀斋所挥之剑,乃飞天御剑流
Dialogue: 0,0:38:52.51,0:38:56.34,*Default,,0,0,0,,是擅长一对多对战的古流剑术
Dialogue: 0,0:39:00.35,0:39:02.38,*Default,,0,0,0,,只要不是这种刀
Dialogue: 0,0:39:04.87,0:39:06.90,*Default,,0,0,0,,毫无疑问能杀死人
Dialogue: 0,0:39:12.35,0:39:13.57,*Default,,0,0,0,,你小子!
Dialogue: 0,0:39:47.03,0:39:48.58,*Default,,0,0,0,,你是...
Dialogue: 0,0:39:57.27,0:39:58.49,*Default,,0,0,0,,小薰
Dialogue: 0,0:39:58.59,0:40:00.06,*Default,,0,0,0,,怎么了,出了什么事
Dialogue: 0,0:40:02.95,0:40:04.54,*Default,,0,0,0,,死人了!
Dialogue: 0,0:40:07.11,0:40:07.98,*Default,,0,0,0,,等等!
Dialogue: 0,0:40:08.11,0:40:09.42,*Default,,0,0,0,,发生什么事了?
Dialogue: 0,0:40:09.55,0:40:10.53,*Default,,0,0,0,,他就是那个杀人犯么?
Dialogue: 0,0:40:10.63,0:40:11.58,*Default,,0,0,0,,不是的
Dialogue: 0,0:40:11.75,0:40:13.74,*Default,,0,0,0,,是这些人突然闯进来袭击我们
Dialogue: 0,0:40:13.95,0:40:15.09,*Default,,0,0,0,,不过没事了
Dialogue: 0,0:40:15.55,0:40:17.90,*Default,,0,0,0,,没人被杀,他们只是晕过去了
Dialogue: 0,0:40:17.99,0:40:19.74,*Default,,0,0,0,,在这边
Dialogue: 0,0:40:22.07,0:40:22.94,*Default,,0,0,0,,什么情况?
Dialogue: 0,0:40:29.99,0:40:31.98,*Default,,0,0,0,,你们不知道废刀令么?
Dialogue: 0,0:40:33.35,0:40:34.30,*Default,,0,0,0,,带走!
Dialogue: 0,0:40:34.47,0:40:35.34,*Default,,0,0,0,,是!
Dialogue: 0,0:40:39.51,0:40:40.62,*Default,,0,0,0,,怎么回事?
Dialogue: 0,0:40:44.79,0:40:46.94,*Default,,0,0,0,,都怪在下
Dialogue: 0,0:40:48.15,0:40:51.42,*Default,,0,0,0,,都是在下这个浪客引发的事
Dialogue: 0,0:40:52.31,0:40:55.62,*Default,,0,0,0,,与此道场无关
Dialogue: 0,0:40:58.63,0:40:59.61,*Default,,0,0,0,,带走
Dialogue: 0,0:41:02.67,0:41:03.65,*Default,,0,0,0,,等等!
Dialogue: 0,0:41:03.99,0:41:06.78,*Default,,0,0,0,,浪客先生
Dialogue: 0,0:41:08.87,0:41:10.50,*Default,,0,0,0,,何事?
Dialogue: 0,0:41:13.67,0:41:15.97,*Default,,0,0,0,,请问阁下高姓大名
Dialogue: 0,0:41:16.91,0:41:18.13,*Default,,0,0,0,,等等!
Dialogue: 0,0:41:22.67,0:41:24.50,*Default,,0,0,0,,在下绯村剑心
Dialogue: 0,0:41:24.99,0:41:25.94,*Default,,0,0,0,,让开!
Dialogue: 0,0:41:27.83,0:41:29.02,*Default,,0,0,0,,剑心
Dialogue: 0,0:41:31.79,0:41:33.50,*Default,,0,0,0,,剑之心?
Dialogue: 0,0:41:42.55,0:41:43.90,*Default,,0,0,0,,安静!
Dialogue: 0,0:41:50.59,0:41:51.70,*Default,,0,0,0,,有新来的
Dialogue: 0,0:41:56.03,0:41:57.17,*Default,,0,0,0,,走快点!
Dialogue: 0,0:42:52.91,0:42:53.89,*Default,,0,0,0,,打开
Dialogue: 0,0:43:12.43,0:43:14.10,*Default,,0,0,0,,十字刀疤的人
Dialogue: 0,0:43:19.27,0:43:20.94,*Default,,0,0,0,,果然是你
Dialogue: 0,0:43:23.27,0:43:24.62,*Default,,0,0,0,,好久不见
Dialogue: 0,0:43:26.31,0:43:27.74,*Default,,0,0,0,,刽子手拔刀斋
Dialogue: 0,0:43:29.79,0:43:31.78,*Default,,0,0,0,,自鸟羽伏见一战以来
Dialogue: 0,0:43:32.79,0:43:34.62,*Default,,0,0,0,,已十年未见了啊
Dialogue: 0,0:43:39.47,0:43:40.61,*Default,,0,0,0,,我有话问你
Dialogue: 0,0:43:43.63,0:43:44.58,*Default,,0,0,0,,出来
Dialogue: 0,0:44:16.83,0:44:19.06,*Default,,0,0,0,,他就是刽子手拔刀斋?
Dialogue: 0,0:44:35.91,0:44:40.02,*Default,,0,0,0,,好久不见,这些年你藏到哪里去了?
Dialogue: 0,0:44:41.19,0:44:42.22,*Default,,0,0,0,,山县先生
Dialogue: 0,0:44:46.67,0:44:50.02,*Default,,0,0,0,,这十年,只要有身手不凡的浪客
Dialogue: 0,0:44:50.27,0:44:55.70,*Default,,0,0,0,,路见不平的传闻,我都派手下去查过
Dialogue: 0,0:45:02.07,0:45:03.10,*Default,,0,0,0,,你问他是怎么回事?
Dialogue: 0,0:45:04.11,0:45:08.22,*Default,,0,0,0,,在那个时代,我们虽然道不同
Dialogue: 0,0:45:09.39,0:45:12.90,*Default,,0,0,0,,但彼此都期盼着一个更好的国家
Dialogue: 0,0:45:16.23,0:45:22.06,*Default,,0,0,0,,他如今改名为藤田五郎,在我手下效力
Dialogue: 0,0:45:25.03,0:45:26.74,*Default,,0,0,0,,找在下何事?
Dialogue: 0,0:45:27.43,0:45:29.58,*Default,,0,0,0,,现有群败类公然买卖
Dialogue: 0,0:45:33.43,0:45:34.90,*Default,,0,0,0,,这个俗称"蜘蛛网"
Dialogue: 0,0:45:35.23,0:45:39.42,*Default,,0,0,0,,表面看就是普通鸦片,不过里面另有千秋
Dialogue: 0,0:45:40.75,0:45:42.74,*Default,,0,0,0,,比以往的瘾性大好几倍
Dialogue: 0,0:45:43.75,0:45:46.10,*Default,,0,0,0,,鸦片终会亡国
Dialogue: 0,0:45:46.27,0:45:50.94,*Default,,0,0,0,,连中华的大清都没能制止鸦片
Dialogue: 0,0:45:52.15,0:45:56.22,*Default,,0,0,0,,致使部分国土沦为了英国的殖民地
Dialogue: 0,0:45:57.43,0:45:59.42,*Default,,0,0,0,,在下只是一介浪客
Dialogue: 0,0:46:00.23,0:46:01.90,*Default,,0,0,0,,为何向在下提这些?
Dialogue: 0,0:46:02.15,0:46:04.30,*Default,,0,0,0,,因为做出这种东西的败类
Dialogue: 0,0:46:05.27,0:46:07.94,*Default,,0,0,0,,肯定在策划更大的阴谋
Dialogue: 0,0:46:20.31,0:46:22.30,*Default,,0,0,0,,请助我一臂之力
Dialogue: 0,0:46:24.47,0:46:26.62,*Default,,0,0,0,,当上陆军军官
Dialogue: 0,0:46:31.47,0:46:34.66,*Default,,0,0,0,,再次用你这身手
Dialogue: 0,0:46:34.79,0:46:37.82,*Default,,0,0,0,,在下无意在刽子手这行担任高官
Dialogue: 0,0:46:46.27,0:46:48.14,*Default,,0,0,0,,刽子手?
Dialogue: 0,0:46:50.11,0:46:53.86,*Default,,0,0,0,,这都是为了完成维新大业!
Dialogue: 0,0:46:55.35,0:46:57.30,*Default,,0,0,0,,没那个胆子了么?
Dialogue: 0,0:46:59.23,0:47:01.38,*Default,,0,0,0,,这是什么可笑的刀?
Dialogue: 0,0:47:05.87,0:47:08.66,*Default,,0,0,0,,刽子手不去杀人,如何来保护人?
Dialogue: 0,0:47:11.51,0:47:13.02,*Default,,0,0,0,,就算用这种刀
Dialogue: 0,0:47:14.19,0:47:16.98,*Default,,0,0,0,,我也能保住视线之内所有人的性命
Dialogue: 0,0:47:17.07,0:47:18.34,*Default,,0,0,0,,那就试试吧
Dialogue: 0,0:47:20.91,0:47:25.54,*Default,,0,0,0,,在说大话之前,先保护好你自己试试
Dialogue: 0,0:47:43.23,0:47:44.54,*Default,,0,0,0,,把刀收起来
Dialogue: 0,0:47:44.87,0:47:45.85,*Default,,0,0,0,,少废话
Dialogue: 0,0:48:22.59,0:48:24.74,*Default,,0,0,0,,对着你的刀刃
Dialogue: 0,0:48:25.23,0:48:28.22,*Default,,0,0,0,,终会伤到你自己的
Dialogue: 0,0:48:34.95,0:48:36.38,*Default,,0,0,0,,就像这样
Dialogue: 0,0:48:40.27,0:48:42.38,*Default,,0,0,0,,想起那个时候了么?
Dialogue: 0,0:48:46.11,0:48:48.30,*Default,,0,0,0,,在下已抛下过往
Dialogue: 0,0:48:49.47,0:48:51.26,*Default,,0,0,0,,不会再杀人
Dialogue: 0,0:48:59.11,0:49:00.30,*Default,,0,0,0,,够了!
Dialogue: 0,0:49:26.31,0:49:27.86,*Default,,0,0,0,,对不起了
Dialogue: 0,0:49:31.15,0:49:31.98,*Default,,0,0,0,,没事
Dialogue: 0,0:49:37.99,0:49:39.30,*Default,,0,0,0,,放了他
Dialogue: 0,0:49:39.55,0:49:40.38,*Default,,0,0,0,,是
Dialogue: 0,0:49:58.51,0:50:00.50,*Default,,0,0,0,,喂,熏?
Dialogue: 0,0:50:33.39,0:50:34.14,*Default,,0,0,0,,熏!
Dialogue: 0,0:50:39.07,0:50:41.74,*Default,,0,0,0,,你没事吧?
Dialogue: 0,0:50:43.27,0:50:44.38,*Default,,0,0,0,,求求你,救救我!
Dialogue: 0,0:50:44.55,0:50:45.74,*Default,,0,0,0,,我被人追杀
Dialogue: 0,0:50:48.23,0:50:49.21,*Default,,0,0,0,,求求你
Dialogue: 0,0:50:59.47,0:51:00.45,*Default,,0,0,0,,熏小姐
Dialogue: 0,0:51:20.63,0:51:22.66,*Default,,0,0,0,,你没地方可去吧?
Dialogue: 0,0:51:32.67,0:51:34.02,*Default,,0,0,0,,来我家吧
Dialogue: 0,0:51:37.59,0:51:39.50,*Default,,0,0,0,,因为你救过我
Dialogue: 0,0:51:44.43,0:51:46.22,*Default,,0,0,0,,你已经知道了吧?
Dialogue: 0,0:51:46.99,0:51:48.34,*Default,,0,0,0,,在下曾是刽子手
Dialogue: 0,0:51:48.43,0:51:50.10,*Default,,0,0,0,,我才不在乎
Dialogue: 0,0:51:56.63,0:51:58.42,*Default,,0,0,0,,我遇见的
Dialogue: 0,0:51:59.07,0:52:01.26,*Default,,0,0,0,,是一个叫剑心的浪客
Dialogue: 0,0:52:03.51,0:52:07.26,*Default,,0,0,0,,谁都会有一两段不愿提及的过往
Dialogue: 0,0:52:09.99,0:52:10.86,*Default,,0,0,0,,对吧?
Dialogue: 0,0:52:14.39,0:52:15.26,*Default,,0,0,0,,给
Dialogue: 0,0:52:17.47,0:52:18.42,*Default,,0,0,0,,拿着
Dialogue: 0,0:52:23.55,0:52:24.42,*Default,,0,0,0,,走吧
Dialogue: 0,0:52:31.67,0:52:32.70,*Default,,0,0,0,,快点!
Dialogue: 0,0:52:35.15,0:52:35.78,*Default,,0,0,0,,走吧!
Dialogue: 0,0:52:47.35,0:52:48.38,*Default,,0,0,0,,进来吧
Dialogue: 0,0:52:49.23,0:52:51.06,*Default,,0,0,0,,打扰了
Dialogue: 0,0:52:55.79,0:52:56.42,*Default,,0,0,0,,弥彦
Dialogue: 0,0:52:59.59,0:53:03.06,*Default,,0,0,0,,他叫明神弥彦,我偶尔会教他剑术
Dialogue: 0,0:53:03.91,0:53:05.22,*Default,,0,0,0,,也算半个食客
Dialogue: 0,0:53:05.99,0:53:09.66,*Default,,0,0,0,,谁叫你一个弟子都没有,我是给你面子才来的!
Dialogue: 0,0:53:09.83,0:53:12.26,*Default,,0,0,0,,虽然言语刻薄,但底子不错
Dialogue: 0,0:53:12.43,0:53:14.58,*Default,,0,0,0,,啰嗦,我是想要变强
Dialogue: 0,0:53:14.75,0:53:16.10,*Default,,0,0,0,,知道了
Dialogue: 0,0:53:16.27,0:53:18.54,*Default,,0,0,0,,剑心从今天开始也住这里
Dialogue: 0,0:53:19.23,0:53:21.26,*Default,,0,0,0,,那我就是师兄了
Dialogue: 0,0:53:22.02,0:53:23.23,*Default,,0,0,0,,什么?
Dialogue: 0,0:53:23.47,0:53:25.26,*Default,,0,0,0,,承蒙您关照了
Dialogue: 0,0:53:26.19,0:53:27.54,*Default,,0,0,0,,好的
Dialogue: 0,0:53:28.51,0:53:32.18,*Default,,0,0,0,,喂,也向我介绍一下吧
Dialogue: 0,0:53:36.27,0:53:37.14,*Default,,0,0,0,,什么?
Dialogue: 0,0:53:37.67,0:53:38.81,*Default,,0,0,0,,你是谁?
Dialogue: 0,0:53:39.15,0:53:41.74,*Default,,0,0,0,,我见她在街上被雨淋湿透了,就让她进来洗个澡
Dialogue: 0,0:53:41.87,0:53:43.22,*Default,,0,0,0,,你怎么擅自...
Dialogue: 0,0:53:43.39,0:53:46.14,*Default,,0,0,0,,那边那位公子是谁?
Dialogue: 0,0:53:50.47,0:53:51.50,*Default,,0,0,0,,等等
Dialogue: 0,0:53:52.11,0:53:54.30,*Default,,0,0,0,,他是浪客剑心
Dialogue: 0,0:53:57.19,0:54:00.26,*Default,,0,0,0,,就是你啊!
Dialogue: 0,0:54:01.19,0:54:03.22,*Default,,0,0,0,,我听这孩子说了
Dialogue: 0,0:54:04.23,0:54:07.18,*Default,,0,0,0,,我叫高荷惠,幸会
Dialogue: 0,0:54:08.59,0:54:10.38,*Default,,0,0,0,,幸会
Dialogue: 0,0:54:33.67,0:54:35.58,*Default,,0,0,0,,总的有套换洗的衣服吧?
Dialogue: 0,0:54:36.31,0:54:37.50,*Default,,0,0,0,,不胜感激
Dialogue: 0,0:54:40.47,0:54:42.38,*Default,,0,0,0,,父亲身材魁梧
Dialogue: 0,0:54:42.75,0:54:46.02,*Default,,0,0,0,,合你身的也只有他年轻时候的衣物了
Dialogue: 0,0:54:46.87,0:54:47.93,*Default,,0,0,0,,是不是...
Dialogue: 0,0:54:49.75,0:54:51.50,*Default,,0,0,0,,颜色太艳了?
Dialogue: 0,0:54:53.19,0:54:55.86,*Default,,0,0,0,,不,无妨
Dialogue: 0,0:55:47.71,0:55:49.66,*Default,,0,0,0,,活人剑
Dialogue: 0,0:55:58.79,0:56:00.62,*Default,,0,0,0,,欢迎光临
Dialogue: 0,0:56:04.91,0:56:06.54,*Default,,0,0,0,,我说你
Dialogue: 0,0:56:07.63,0:56:10.22,*Default,,0,0,0,,为什么你也跟过来了?
Dialogue: 0,0:56:10.75,0:56:15.02,*Default,,0,0,0,,这姑娘觉得我碍眼了
Dialogue: 0,0:56:16.67,0:56:18.82,*Default,,0,0,0,,你不是这附近的人吧?
Dialogue: 0,0:56:18.95,0:56:21.46,*Default,,0,0,0,,你家在哪里,从哪里来的?
Dialogue: 0,0:56:21.63,0:56:22.61,*Default,,0,0,0,,秘密
Dialogue: 0,0:56:22.75,0:56:24.86,*Default,,0,0,0,,谜一样的女人不是很有魅力么?
Dialogue: 0,0:56:24.99,0:56:26.50,*Default,,0,0,0,,问完了吧?
Dialogue: 0,0:56:29.27,0:56:30.06,*Default,,0,0,0,,请用吧
Dialogue: 0,0:56:30.27,0:56:32.26,*Default,,0,0,0,,不胜感激
Dialogue: 0,0:56:35.87,0:56:39.78,*Default,,0,0,0,,这是为了答谢你救过我,多吃点
Dialogue: 0,0:56:41.95,0:56:43.14,*Default,,0,0,0,,那在下...
Dialogue: 0,0:56:48.31,0:56:48.98,*Default,,0,0,0,,好吃
Dialogue: 0,0:56:49.87,0:56:50.54,*Default,,0,0,0,,好吃吧?
Dialogue: 0,0:56:50.67,0:56:51.94,*Default,,0,0,0,,好烫!
Dialogue: 0,0:56:52.63,0:56:54.14,*Default,,0,0,0,,小心点吃啊!
Dialogue: 0,0:56:54.35,0:56:55.49,*Default,,0,0,0,,我知道啦
Dialogue: 0,0:56:55.95,0:56:57.01,*Default,,0,0,0,,小薰
Dialogue: 0,0:56:57.99,0:57:00.55,*Default,,0,0,0,,听说你们道场最近不太平啊
Dialogue: 0,0:57:00.71,0:57:01.69,*Default,,0,0,0,,妙姐姐
Dialogue: 0,0:57:02.71,0:57:04.42,*Default,,0,0,0,,你可不能屈服
Dialogue: 0,0:57:04.87,0:57:05.98,*Default,,0,0,0,,这里的所有人
Dialogue: 0,0:57:06.07,0:57:08.74,*Default,,0,0,0,,也都决定无论如何不会卖地给他们
Dialogue: 0,0:57:09.07,0:57:10.82,*Default,,0,0,0,,欢迎光临
Dialogue: 0,0:57:12.67,0:57:14.42,*Default,,0,0,0,,欢迎光临!
Dialogue: 0,0:57:17.35,0:57:19.38,*Default,,0,0,0,,武田观柳
Dialogue: 0,0:57:19.55,0:57:21.93,*Default,,0,0,0,,他是在郊外拥有豪宅的实业家
Dialogue: 0,0:57:23.71,0:57:24.62,*Default,,0,0,0,,厕所在哪儿?
Dialogue: 0,0:57:25.11,0:57:26.06,*Default,,0,0,0,,那边
Dialogue: 0,0:57:35.03,0:57:36.06,*Default,,0,0,0,,观柳大人
Dialogue: 0,0:57:42.03,0:57:44.02,*Default,,0,0,0,,抱歉打扰你们用餐了
Dialogue: 0,0:57:45.71,0:57:46.90,*Default,,0,0,0,,就是你么?
Dialogue: 0,0:57:47.03,0:57:51.82,*Default,,0,0,0,,一个人从十个暴徒手中保护了道场的英雄?
Dialogue: 0,0:57:55.59,0:57:59.06,*Default,,0,0,0,,我是做贸易买卖的
Dialogue: 0,0:58:02.71,0:58:03.58,*Default,,0,0,0,,给他瞧瞧
Dialogue: 0,0:58:05.51,0:58:07.78,*Default,,0,0,0,,我们就开门见山了
Dialogue: 0,0:58:08.71,0:58:11.42,*Default,,0,0,0,,我们想用这些钱雇你
Dialogue: 0,0:58:11.71,0:58:16.62,*Default,,0,0,0,,如果你有十人份的能耐,报酬也会是十倍
Dialogue: 0,0:58:16.75,0:58:19.98,*Default,,0,0,0,,如何,要不要做我们的护卫?
Dialogue: 0,0:58:21.39,0:58:23.54,*Default,,0,0,0,,恕在下拒绝
Dialogue: 0,0:58:32.59,0:58:34.14,*Default,,0,0,0,,这些钱还不够么?
Dialogue: 0,0:58:38.07,0:58:39.46,*Default,,0,0,0,,原来如此
Dialogue: 0,0:58:39.59,0:58:42.30,*Default,,0,0,0,,这就是武士所谓的心高气傲啊?
Dialogue: 0,0:58:42.43,0:58:44.42,*Default,,0,0,0,,这样也好
Dialogue: 0,0:58:45.91,0:58:50.50,*Default,,0,0,0,,不过明治时代,是金钱至上的世道
Dialogue: 0,0:58:50.63,0:58:54.46,*Default,,0,0,0,,很遗憾,你的那份骄傲一钱不值
Dialogue: 0,0:58:54.59,0:58:56.02,*Default,,0,0,0,,不如说
Dialogue: 0,0:58:56.11,0:58:58.30,*Default,,0,0,0,,士族阶层就是因为太把那东西当回事了
Dialogue: 0,0:58:58.43,0:58:59.94,*Default,,0,0,0,,所以才会接踵败落
Dialogue: 0,0:59:00.03,0:59:02.38,*Default,,0,0,0,,结果,时至今日,看看街头的烟花柳巷
Dialogue: 0,0:59:02.51,0:59:05.58,*Default,,0,0,0,,处处都是原来武士家的夫人小姐
Dialogue: 0,0:59:05.79,0:59:10.42,*Default,,0,0,0,,抓到的盗贼也都是落魄士族,这就是现在的世道
Dialogue: 0,0:59:13.51,0:59:16.62,*Default,,0,0,0,,把自己还是武士的事忘了吧
Dialogue: 0,0:59:19.79,0:59:20.82,*Default,,0,0,0,,记住
Dialogue: 0,0:59:21.15,0:59:22.46,*Default,,0,0,0,,快快乐乐
Dialogue: 0,0:59:23.79,0:59:24.93,*Default,,0,0,0,,活着就好
Dialogue: 0,0:59:31.47,0:59:32.90,*Default,,0,0,0,,你还真失礼
Dialogue: 0,0:59:47.95,0:59:51.14,*Default,,0,0,0,,如果没钱,牛肉火锅也吃不起哦
Dialogue: 0,0:59:53.19,0:59:55.06,*Default,,0,0,0,,那我来收下那些钱
Dialogue: 0,0:59:55.19,0:59:56.50,*Default,,0,0,0,,左之助先生
Dialogue: 0,0:59:56.59,0:59:57.86,*Default,,0,0,0,,等...!
Dialogue: 0,1:00:03.83,1:00:05.62,*Default,,0,0,0,,雇我吧
Dialogue: 0,1:00:06.71,1:00:07.85,*Default,,0,0,0,,你是什么人?
Dialogue: 0,1:00:10.91,1:00:12.98,*Default,,0,0,0,,我是打手相乐左之助
Dialogue: 0,1:00:13.19,1:00:16.02,*Default,,0,0,0,,刚从牢里出来,正好缺钱
Dialogue: 0,1:00:16.23,1:00:18.61,*Default,,0,0,0,,你的本事
Dialogue: 0,1:00:19.79,1:00:21.18,*Default,,0,0,0,,值这么多钱么?
Dialogue: 0,1:00:22.87,1:00:26.65,*Default,,0,0,0,,要不要比比看,传说中的侩子手
Dialogue: 0,1:00:27.35,1:00:28.98,*Default,,0,0,0,,绯村拔刀斋
Dialogue: 0,1:00:29.99,1:00:30.54,*Default,,0,0,0,,什么!
Dialogue: 0,1:00:40.15,1:00:42.86,*Default,,0,0,0,,如果我赢了他,就雇我,如何?
Dialogue: 0,1:00:43.03,1:00:45.66,*Default,,0,0,0,,在此处比试多有不便
Dialogue: 0,1:00:46.31,1:00:48.69,*Default,,0,0,0,,能到外面去么?
Dialogue: 0,1:00:51.95,1:00:53.82,*Default,,0,0,0,,等很久了!
Dialogue: 0,1:00:54.23,1:00:55.18,*Default,,0,0,0,,大家快出去
Dialogue: 0,1:00:55.27,1:00:57.06,*Default,,0,0,0,,打架了
Dialogue: 0,1:00:59.07,1:01:00.10,*Default,,0,0,0,,这把刀
Dialogue: 0,1:01:01.11,1:01:04.62,*Default,,0,0,0,,是斩马用的斩马刀
Dialogue: 0,1:01:05.03,1:01:07.59,*Default,,0,0,0,,是应仁之乱时期的古董
Dialogue: 0,1:01:13.71,1:01:17.94,*Default,,0,0,0,,疏于保养,一点也不锋利
Dialogue: 0,1:01:18.07,1:01:18.94,*Default,,0,0,0,,但是
Dialogue: 0,1:01:24.91,1:01:27.74,*Default,,0,0,0,,把对手砸烂还是没问题的
Dialogue: 0,1:01:39.59,1:01:40.38,*Default,,0,0,0,,站住!
Dialogue: 0,1:01:49.31,1:01:50.78,*Default,,0,0,0,,绯村拔刀斋
Dialogue: 0,1:01:52.43,1:01:54.02,*Default,,0,0,0,,长州派维新志士
Dialogue: 0,1:01:54.79,1:01:58.41,*Default,,0,0,0,,14岁到19岁的5年间作为刽子手活跃于世
Dialogue: 0,1:02:02.95,1:02:06.54,*Default,,0,0,0,,但最近十年,世间却无人知道你的下落
Dialogue: 0,1:02:20.39,1:02:22.34,*Default,,0,0,0,,不错嘛
Dialogue: 0,1:02:22.99,1:02:23.90,*Default,,0,0,0,,让开!
Dialogue: 0,1:02:24.31,1:02:26.61,*Default,,0,0,0,,让开
Dialogue: 0,1:02:37.75,1:02:39.82,*Default,,0,0,0,,把刀收起来
Dialogue: 0,1:02:43.19,1:02:46.30,*Default,,0,0,0,,拔出刀来与我一战
Dialogue: 0,1:02:48.51,1:02:50.81,*Default,,0,0,0,,在下不想与你交战
Dialogue: 0,1:02:50.95,1:02:51.90,*Default,,0,0,0,,为何?!
Dialogue: 0,1:02:57.03,1:02:59.30,*Default,,0,0,0,,你我无交战理由
Dialogue: 0,1:03:08.55,1:03:10.22,*Default,,0,0,0,,那种人
Dialogue: 0,1:03:11.31,1:03:13.58,*Default,,0,0,0,,他不值得你出卖你的本事
Dialogue: 0,1:03:20.23,1:03:23.54,*Default,,0,0,0,,怎么了
Dialogue: 0,1:03:24.55,1:03:26.74,*Default,,0,0,0,,怎么了
Dialogue: 0,1:03:27.71,1:03:29.38,*Default,,0,0,0,,你愣在那里干嘛,打架的?
Dialogue: 0,1:03:29.71,1:03:31.30,*Default,,0,0,0,,快点打倒他啊!
Dialogue: 0,1:03:32.75,1:03:33.70,*Default,,0,0,0,,吵死了!
Dialogue: 0,1:03:34.03,1:03:36.66,*Default,,0,0,0,,轮不到你们来对我的打架方式指手画脚
Dialogue: 0,1:03:36.75,1:03:37.78,*Default,,0,0,0,,打完了么?
Dialogue: 0,1:03:51.11,1:03:52.33,*Default,,0,0,0,,算了
Dialogue: 0,1:03:53.87,1:03:56.38,*Default,,0,0,0,,要是又被请去差馆就不好了
Dialogue: 0,1:03:58.39,1:04:00.06,*Default,,0,0,0,,吵到大家了
Dialogue: 0,1:04:00.63,1:04:02.10,*Default,,0,0,0,,大家回店里去吧!
Dialogue: 0,1:04:02.31,1:04:03.74,*Default,,0,0,0,,余兴而已
Dialogue: 0,1:04:06.51,1:04:07.90,*Default,,0,0,0,,结束了
Dialogue: 0,1:04:08.47,1:04:09.26,*Default,,0,0,0,,回去吧
Dialogue: 0,1:04:12.43,1:04:14.02,*Default,,0,0,0,,吵到你们了
Dialogue: 0,1:04:18.23,1:04:19.74,*Default,,0,0,0,,好了,去吃饭吧
Dialogue: 0,1:04:19.91,1:04:22.02,*Default,,0,0,0,,牛肉火锅不吃就浪费了
Dialogue: 0,1:04:22.99,1:04:25.06,*Default,,0,0,0,,他可是真家伙
Dialogue: 0,1:04:26.87,1:04:28.86,*Default,,0,0,0,,给我小心点
Dialogue: 0,1:04:34.79,1:04:39.78,*Default,,0,0,0,,千万不要激怒拔刀斋
Dialogue: 0,1:04:40.79,1:04:42.01,*Default,,0,0,0,,遵命!
Dialogue: 0,1:04:50.91,1:04:52.94,*Default,,0,0,0,,血还不够
Dialogue: 0,1:04:56.87,1:04:59.50,*Default,,0,0,0,,血还远远不够
Dialogue: 0,1:05:01.95,1:05:04.25,*Default,,0,0,0,,这是我的做法
Dialogue: 0,1:05:06.27,1:05:09.97,*Default,,0,0,0,,我才是刽子手拔刀斋
Dialogue: 0,1:05:23.07,1:05:25.30,*Default,,0,0,0,,又是假拔刀斋干的
Dialogue: 0,1:05:26.23,1:05:31.30,*Default,,0,0,0,,这些人也杀,警察也杀,他到底帮谁啊?
Dialogue: 0,1:05:33.07,1:05:36.98,*Default,,0,0,0,,一旦杀了人就无法回头了
Dialogue: 0,1:05:37.83,1:05:41.18,*Default,,0,0,0,,这就是刽子手的命运
Dialogue: 0,1:05:46.07,1:05:48.22,*Default,,0,0,0,,你们先请回
Dialogue: 0,1:05:50.27,1:05:51.18,*Default,,0,0,0,,走吧
Dialogue: 0,1:05:51.51,1:05:52.18,*Default,,0,0,0,,等等
Dialogue: 0,1:05:53.23,1:05:54.37,*Default,,0,0,0,,知道啦!
Dialogue: 0,1:06:00.11,1:06:02.34,*Default,,0,0,0,,是袭击道场的那些人
Dialogue: 0,1:06:03.67,1:06:05.86,*Default,,0,0,0,,还不如当初被你收拾了
Dialogue: 0,1:06:08.83,1:06:10.78,*Default,,0,0,0,,或者说,你要是收拾了他们
Dialogue: 0,1:06:11.95,1:06:14.70,*Default,,0,0,0,,那些警察就可以免遭牵连
Dialogue: 0,1:06:17.99,1:06:19.74,*Default,,0,0,0,,你的逆刃刀
Dialogue: 0,1:06:21.35,1:06:23.22,*Default,,0,0,0,,还真是管用啊
Dialogue: 0,1:06:31.35,1:06:32.02,*Default,,0,0,0,,让开!
Dialogue: 0,1:06:32.19,1:06:33.54,*Default,,0,0,0,,别挡路
Dialogue: 0,1:07:26.99,1:07:31.98,*Default,,0,0,0,,能否为了新时代,作为刺客为我等效力?
Dialogue: 0,1:07:40.79,1:07:43.50,*Default,,0,0,0,,如果那些人的牺牲
Dialogue: 0,1:07:48.15,1:07:51.14,*Default,,0,0,0,,能换来太平安宁的...
Dialogue: 0,1:07:54.03,1:07:56.33,*Default,,0,0,0,,新时代的话
Dialogue: 0,1:07:58.79,1:08:01.35,*Default,,0,0,0,,在这天下大乱之时
Dialogue: 0,1:08:01.55,1:08:03.26,*Default,,0,0,0,,你居然就要大婚了啊!
Dialogue: 0,1:08:04.43,1:08:05.82,*Default,,0,0,0,,对不住了
Dialogue: 0,1:08:05.99,1:08:07.30,*Default,,0,0,0,,这不是挺好的么?
Dialogue: 0,1:08:07.87,1:08:09.82,*Default,,0,0,0,,幸运的混蛋
Dialogue: 0,1:08:10.19,1:08:11.78,*Default,,0,0,0,,真让人羡慕
Dialogue: 0,1:08:23.35,1:08:25.81,*Default,,0,0,0,,来者何人,报上名来
Dialogue: 0,1:08:27.51,1:08:29.42,*Default,,0,0,0,,你就是拔刀斋么?!
Dialogue: 0,1:08:40.03,1:08:42.46,*Default,,0,0,0,,你这个萨长走狗!
Dialogue: 0,1:08:44.87,1:08:46.06,*Default,,0,0,0,,受死吧!
Dialogue: 0,1:09:04.35,1:09:06.86,*Default,,0,0,0,,我不想死
Dialogue: 0,1:09:14.59,1:09:16.14,*Default,,0,0,0,,我不能死
Dialogue: 0,1:09:21.31,1:09:27.06,*Default,,0,0,0,,还有重要的人等着我,还不能死!
Dialogue: 0,1:09:41.59,1:09:44.38,*Default,,0,0,0,,我还不能死!
Dialogue: 0,1:09:46.07,1:09:47.94,*Default,,0,0,0,,还有重要的人...
Dialogue: 0,1:10:20.67,1:10:22.26,*Default,,0,0,0,,我不能死
Dialogue: 0,1:10:33.99,1:10:40.22,*Default,,0,0,0,,我不能死
Dialogue: 0,1:13:15.35,1:13:18.22,*Default,,0,0,0,,连肩负未来的年轻人都杀
Dialogue: 0,1:13:19.63,1:13:22.82,*Default,,0,0,0,,为了新时代的暗杀到底意义何在?
Dialogue: 0,1:13:28.79,1:13:31.78,*Default,,0,0,0,,我所做的是正确的么?
Dialogue: 0,1:13:35.83,1:13:38.82,*Default,,0,0,0,,你不过是个杀人犯
Dialogue: 0,1:14:11.31,1:14:12.34,*Default,,0,0,0,,剑心
Dialogue: 0,1:14:15.55,1:14:16.58,*Default,,0,0,0,,熏小姐
Dialogue: 0,1:14:19.19,1:14:22.78,*Default,,0,0,0,,你一直没回来,还以为你发生什么事了
Dialogue: 0,1:14:26.91,1:14:30.61,*Default,,0,0,0,,我还以为你走了
Dialogue: 0,1:14:38.19,1:14:40.30,*Default,,0,0,0,,我肚子饿了
Dialogue: 0,1:15:24.59,1:15:26.58,*Default,,0,0,0,,太棒了!
Dialogue: 0,1:15:28.75,1:15:32.45,*Default,,0,0,0,,没想到世间真有这东西
Dialogue: 0,1:15:32.59,1:15:34.34,*Default,,0,0,0,,计划怎么样了?
Dialogue: 0,1:15:34.83,1:15:36.42,*Default,,0,0,0,,都安排好了
Dialogue: 0,1:15:39.55,1:15:42.46,*Default,,0,0,0,,把这一带夷平,改建成港口
Dialogue: 0,1:15:42.59,1:15:45.34,*Default,,0,0,0,,- 然后从这里运出鸦片  - 往哪里运?
Dialogue: 0,1:15:45.87,1:15:47.86,*Default,,0,0,0,,全日本!
Dialogue: 0,1:15:49.91,1:15:50.78,*Default,,0,0,0,,不
Dialogue: 0,1:15:53.79,1:15:55.70,*Default,,0,0,0,,全世界
Dialogue: 0,1:15:58.59,1:16:01.74,*Default,,0,0,0,,用从沉迷于鸦片的野兽手中赚到的钱
Dialogue: 0,1:16:02.91,1:16:04.46,*Default,,0,0,0,,去买武器
Dialogue: 0,1:16:09.63,1:16:11.42,*Default,,0,0,0,,就能创造观柳帝国了!
Dialogue: 0,1:16:20.39,1:16:23.06,*Default,,0,0,0,,新政府将由我取而代之
Dialogue: 0,1:16:52.83,1:16:54.78,*Default,,0,0,0,,要开始了
Dialogue: 0,1:16:58.43,1:17:01.42,*Default,,0,0,0,,觉醒吧,拔刀斋
Dialogue: 0,1:17:52.99,1:17:53.97,*Default,,0,0,0,,惠
Dialogue: 0,1:17:56.75,1:17:58.86,*Default,,0,0,0,,没想到你在这种地方
Dialogue: 0,1:18:04.91,1:18:08.61,*Default,,0,0,0,,你和精制鸦片这件事的关系铁证如山
Dialogue: 0,1:18:10.75,1:18:13.70,*Default,,0,0,0,,你和我们...不,和鸦片
Dialogue: 0,1:18:14.39,1:18:16.58,*Default,,0,0,0,,是一条船上的
Dialogue: 0,1:18:22.19,1:18:25.10,*Default,,0,0,0,,同伴一场,给你个忠告
Dialogue: 0,1:18:28.43,1:18:29.65,*Default,,0,0,0,,小心点
Dialogue: 0,1:19:02.47,1:19:03.94,*Default,,0,0,0,,饭是惠煮的
Dialogue: 0,1:19:06.19,1:19:09.46,*Default,,0,0,0,,味增汤是剑心做的
Dialogue: 0,1:19:11.87,1:19:13.82,*Default,,0,0,0,,鱼是熏做的
Dialogue: 0,1:19:18.19,1:19:19.98,*Default,,0,0,0,,你还是多学学怎么做饭吧
Dialogue: 0,1:19:20.15,1:19:23.74,*Default,,0,0,0,,不是常说,结婚就要找会做饭的女人么
Dialogue: 0,1:19:26.59,1:19:27.94,*Default,,0,0,0,,他要被抢走了哦
Dialogue: 0,1:19:28.67,1:19:29.73,*Default,,0,0,0,,闭嘴吧你!
Dialogue: 0,1:19:31.55,1:19:33.14,*Default,,0,0,0,,真是的
Dialogue: 0,1:19:33.51,1:19:35.89,*Default,,0,0,0,,谁能替我收几个弟子回来啊
Dialogue: 0,1:19:37.19,1:19:39.82,*Default,,0,0,0,,教这种小屁孩,剑术会退化的
Dialogue: 0,1:19:39.95,1:19:41.58,*Default,,0,0,0,,这话该我说吧!
Dialogue: 0,1:19:41.71,1:19:43.90,*Default,,0,0,0,,罢了罢了,你们两个
Dialogue: 0,1:19:44.07,1:19:45.94,*Default,,0,0,0,,先吃饭吧
Dialogue: 0,1:19:47.55,1:19:49.02,*Default,,0,0,0,,喂,小薰
Dialogue: 0,1:19:49.51,1:19:51.86,*Default,,0,0,0,,有人吗,有人在吗?
Dialogue: 0,1:19:52.07,1:19:53.18,*Default,,0,0,0,,小薰
Dialogue: 0,1:19:53.51,1:19:54.78,*Default,,0,0,0,,救救我们
Dialogue: 0,1:19:57.91,1:20:00.70,*Default,,0,0,0,,这孩子突然身体麻痹
Dialogue: 0,1:20:01.11,1:20:03.67,*Default,,0,0,0,,呼吸急促,然后...
Dialogue: 0,1:20:03.79,1:20:05.22,*Default,,0,0,0,,去看大夫了么?
Dialogue: 0,1:20:05.59,1:20:10.61,*Default,,0,0,0,,这附近的大夫从前天开始都下落不明了
Dialogue: 0,1:20:15.71,1:20:18.34,*Default,,0,0,0,,我们不知该如何是好
Dialogue: 0,1:20:18.63,1:20:19.38,*Default,,0,0,0,,嗨
Dialogue: 0,1:20:37.07,1:20:38.21,*Default,,0,0,0,,小心点
Dialogue: 0,1:20:42.27,1:20:45.22,*Default,,0,0,0,,把这个道场弄到手
Dialogue: 0,1:20:50.59,1:20:52.70,*Default,,0,0,0,,小薰
Dialogue: 0,1:20:53.03,1:20:53.94,*Default,,0,0,0,,救救我们
Dialogue: 0,1:20:54.11,1:20:55.58,*Default,,0,0,0,,小薰
Dialogue: 0,1:20:55.83,1:20:57.14,*Default,,0,0,0,,小薰,救救我们!
Dialogue: 0,1:20:57.31,1:20:58.26,*Default,,0,0,0,,怎么了?
Dialogue: 0,1:21:01.03,1:21:01.78,*Default,,0,0,0,,燕!
Dialogue: 0,1:21:01.87,1:21:04.10,*Default,,0,0,0,,早上就开始说肚子疼
Dialogue: 0,1:21:04.19,1:21:05.46,*Default,,0,0,0,,后来晕倒了
Dialogue: 0,1:21:11.67,1:21:12.34,*Default,,0,0,0,,这边吗?
Dialogue: 0,1:21:16.03,1:21:17.25,*Default,,0,0,0,,到底怎么回事?
Dialogue: 0,1:21:20.11,1:21:21.22,*Default,,0,0,0,,是瘟疫么?
Dialogue: 0,1:21:24.39,1:21:26.06,*Default,,0,0,0,,谁快去叫大夫来!
Dialogue: 0,1:21:27.15,1:21:28.62,*Default,,0,0,0,,大夫在这里
Dialogue: 0,1:21:30.11,1:21:31.06,*Default,,0,0,0,,拜托了!
Dialogue: 0,1:21:35.23,1:21:36.74,*Default,,0,0,0,,高烧,昏迷
Dialogue: 0,1:21:39.79,1:21:41.30,*Default,,0,0,0,,是灭鼠药的毒性么?
Dialogue: 0,1:21:42.03,1:21:42.62,*Default,,0,0,0,,什么?
Dialogue: 0,1:21:42.71,1:21:44.30,*Default,,0,0,0,,毒,当真么?
Dialogue: 0,1:21:44.63,1:21:47.19,*Default,,0,0,0,,必须尽快给她排毒,我还要水
Dialogue: 0,1:21:47.31,1:21:48.86,*Default,,0,0,0,,不过井水不行
Dialogue: 0,1:21:49.03,1:21:51.02,*Default,,0,0,0,,里面可能有人投毒了
Dialogue: 0,1:21:51.23,1:21:52.29,*Default,,0,0,0,,什么?!
Dialogue: 0,1:21:53.43,1:21:55.38,*Default,,0,0,0,,去药铺买些蓖麻油来
Dialogue: 0,1:21:55.71,1:21:57.38,*Default,,0,0,0,,还有毛巾和药罐
Dialogue: 0,1:21:57.55,1:21:58.18,*Default,,0,0,0,,你!
Dialogue: 0,1:21:58.31,1:22:01.06,*Default,,0,0,0,,去水店把所有的水都买来
Dialogue: 0,1:22:01.15,1:22:01.70,*Default,,0,0,0,,好
Dialogue: 0,1:22:01.79,1:22:04.14,*Default,,0,0,0,,小薰,邻镇有没有中医?
Dialogue: 0,1:22:05.31,1:22:06.34,*Default,,0,0,0,,有的
Dialogue: 0,1:22:06.67,1:22:08.30,*Default,,0,0,0,,去把我开的药带回来
Dialogue: 0,1:22:11.75,1:22:14.58,*Default,,0,0,0,,解毒必须争分夺秒,快点!
Dialogue: 0,1:22:15.35,1:22:16.82,*Default,,0,0,0,,是
Dialogue: 0,1:22:29.39,1:22:31.50,*Default,,0,0,0,,水来了,谁要水?
Dialogue: 0,1:22:38.07,1:22:39.50,*Default,,0,0,0,,马上就会好的
Dialogue: 0,1:22:59.39,1:23:00.78,*Default,,0,0,0,,会好的
Dialogue: 0,1:23:33.59,1:23:34.90,*Default,,0,0,0,,不可原谅
Dialogue: 0,1:23:37.15,1:23:38.94,*Default,,0,0,0,,视人命如草芥
Dialogue: 0,1:23:47.31,1:23:48.42,*Default,,0,0,0,,惠小姐
Dialogue: 0,1:23:50.27,1:23:53.58,*Default,,0,0,0,,是时候把你的真实身份说出来了吧
Dialogue: 0,1:23:58.55,1:24:01.11,*Default,,0,0,0,,是高荷小姐么?
Dialogue: 0,1:24:01.27,1:24:02.98,*Default,,0,0,0,,您是说小惠么?
Dialogue: 0,1:24:03.11,1:24:04.14,*Default,,0,0,0,,你认识她么?
Dialogue: 0,1:24:04.27,1:24:05.94,*Default,,0,0,0,,当然
Dialogue: 0,1:24:06.07,1:24:10.70,*Default,,0,0,0,,做医生的,无人不知晓高荷世家
Dialogue: 0,1:24:13.11,1:24:14.25,*Default,,0,0,0,,高荷家
Dialogue: 0,1:24:14.83,1:24:18.22,*Default,,0,0,0,,是世代从医,历史悠久的名门望族
Dialogue: 0,1:24:19.27,1:24:21.94,*Default,,0,0,0,,但在会津之战时
Dialogue: 0,1:24:22.35,1:24:26.62,*Default,,0,0,0,,全家从军,听说都战死了
Dialogue: 0,1:24:28.31,1:24:29.82,*Default,,0,0,0,,这样啊
Dialogue: 0,1:24:30.51,1:24:32.54,*Default,,0,0,0,,女儿幸存了下来
Dialogue: 0,1:24:42.47,1:24:45.90,*Default,,0,0,0,,你曾是刽子手吧?
Dialogue: 0,1:24:51.07,1:24:53.18,*Default,,0,0,0,,在问别人话前
Dialogue: 0,1:24:54.71,1:24:57.90,*Default,,0,0,0,,不是该先把自己的事交代清楚么?
Dialogue: 0,1:25:08.99,1:25:15.58,*Default,,0,0,0,,你应该手刃过无数条性命吧?
Dialogue: 0,1:25:20.47,1:25:22.02,*Default,,0,0,0,,这疤怎么回事?
Dialogue: 0,1:25:23.67,1:25:25.18,*Default,,0,0,0,,是你引以为豪的么?
Dialogue: 0,1:25:26.87,1:25:28.70,*Default,,0,0,0,,是某种勋章么?
Dialogue: 0,1:25:37.83,1:25:39.30,*Default,,0,0,0,,这道疤
Dialogue: 0,1:25:44.15,1:25:46.74,*Default,,0,0,0,,受自我杀掉的一个年轻武士
Dialogue: 0,1:25:53.39,1:25:55.22,*Default,,0,0,0,,另一道疤
Dialogue: 0,1:25:59.63,1:26:03.58,*Default,,0,0,0,,受自他的未婚妻
Dialogue: 0,1:26:10.91,1:26:12.78,*Default,,0,0,0,,数不清的人
Dialogue: 0,1:26:15.91,1:26:17.18,*Default,,0,0,0,,死于在下手上
Dialogue: 0,1:26:17.27,1:26:19.22,*Default,,0,0,0,,我跟你不同
Dialogue: 0,1:26:21.87,1:26:25.57,*Default,,0,0,0,,父母双亡,也没有可投靠的亲人
Dialogue: 0,1:26:31.07,1:26:33.26,*Default,,0,0,0,,我被观柳收留
Dialogue: 0,1:26:37.79,1:26:39.78,*Default,,0,0,0,,成了他的女人
Dialogue: 0,1:26:50.79,1:26:53.58,*Default,,0,0,0,,我和他只是互相利用而已
Dialogue: 0,1:26:58.75,1:27:03.10,*Default,,0,0,0,,他是为了靠鸦片敛财,而我...
Dialogue: 0,1:27:08.91,1:27:10.42,*Default,,0,0,0,,是为了活下去
Dialogue: 0,1:27:16.15,1:27:17.74,*Default,,0,0,0,,为了活下去
Dialogue: 0,1:27:32.63,1:27:35.66,*Default,,0,0,0,,请给我鸦片,求你了!
Dialogue: 0,1:27:36.55,1:27:37.42,*Default,,0,0,0,,不行
Dialogue: 0,1:27:38.51,1:27:40.81,*Default,,0,0,0,,吵死了,安静点!
Dialogue: 0,1:28:54.15,1:28:57.06,*Default,,0,0,0,,观柳的私人兵团大概有250人
Dialogue: 0,1:28:58.75,1:29:01.66,*Default,,0,0,0,,其中夹杂着不少武艺高强的士族
Dialogue: 0,1:29:01.83,1:29:04.34,*Default,,0,0,0,,都是被维新逼得走投无路的
Dialogue: 0,1:29:09.59,1:29:11.06,*Default,,0,0,0,,我也一起去
Dialogue: 0,1:29:18.07,1:29:19.18,*Default,,0,0,0,,剑心
Dialogue: 0,1:29:21.23,1:29:22.74,*Default,,0,0,0,,剑心,看这个
Dialogue: 0,1:29:23.35,1:29:24.82,*Default,,0,0,0,,小惠不见了
Dialogue: 0,1:29:31.95,1:29:33.17,*Default,,0,0,0,,难道...
Dialogue: 0,1:30:05.27,1:30:06.33,*Default,,0,0,0,,我也一起去
Dialogue: 0,1:30:08.63,1:30:10.18,*Default,,0,0,0,,熏小姐就留在这里
Dialogue: 0,1:30:13.39,1:30:16.46,*Default,,0,0,0,,神谷活心流的当家如果有个闪失就不好了
Dialogue: 0,1:30:16.59,1:30:17.46,*Default,,0,0,0,,可是...
Dialogue: 0,1:30:17.59,1:30:20.18,*Default,,0,0,0,,这一去恐怕会杀个通宵
Dialogue: 0,1:30:21.39,1:30:24.78,*Default,,0,0,0,,准备好五人份的早餐和洗澡水吧
Dialogue: 0,1:30:25.19,1:30:26.33,*Default,,0,0,0,,我也去
Dialogue: 0,1:30:27.19,1:30:28.02,*Default,,0,0,0,,等等!
Dialogue: 0,1:30:31.15,1:30:34.06,*Default,,0,0,0,,你去了也只能拖后腿
Dialogue: 0,1:30:34.15,1:30:34.78,*Default,,0,0,0,,要你管!
Dialogue: 0,1:30:34.91,1:30:35.82,*Default,,0,0,0,,弥彦
Dialogue: 0,1:30:41.27,1:30:42.74,*Default,,0,0,0,,你留在道场
Dialogue: 0,1:30:43.27,1:30:44.14,*Default,,0,0,0,,什么?
Dialogue: 0,1:30:48.43,1:30:50.50,*Default,,0,0,0,,熏小姐和道场就交给你了
Dialogue: 0,1:31:39.39,1:31:40.90,*Default,,0,0,0,,我就知道
Dialogue: 0,1:31:42.47,1:31:44.85,*Default,,0,0,0,,你肯定会回来的
Dialogue: 0,1:31:45.95,1:31:47.86,*Default,,0,0,0,,因为除了这里
Dialogue: 0,1:31:49.91,1:31:52.26,*Default,,0,0,0,,你无处可去
Dialogue: 0,1:31:52.99,1:31:56.02,*Default,,0,0,0,,明天开始好好卖力
Dialogue: 0,1:31:56.11,1:31:57.82,*Default,,0,0,0,,我回来
Dialogue: 0,1:32:00.91,1:32:03.06,*Default,,0,0,0,,不是为了继续做鸦片
Dialogue: 0,1:32:04.15,1:32:04.90,*Default,,0,0,0,,什么?
Dialogue: 0,1:32:05.59,1:32:07.26,*Default,,0,0,0,,是来杀你的!
Dialogue: 0,1:32:12.27,1:32:13.74,*Default,,0,0,0,,放心吧
Dialogue: 0,1:32:14.19,1:32:16.46,*Default,,0,0,0,,你我是一条船上的
Dialogue: 0,1:32:17.43,1:32:19.54,*Default,,0,0,0,,我也会马上陪你下去的!
Dialogue: 0,1:32:19.67,1:32:21.42,*Default,,0,0,0,,你们几个发什么呆!
Dialogue: 0,1:32:21.71,1:32:22.98,*Default,,0,0,0,,别干傻事
Dialogue: 0,1:32:23.31,1:32:24.66,*Default,,0,0,0,,这是我的赎罪!
Dialogue: 0,1:32:31.63,1:32:32.85,*Default,,0,0,0,,你这贱女人!
Dialogue: 0,1:32:33.07,1:32:36.50,*Default,,0,0,0,,对你好点就得意忘形了
Dialogue: 0,1:32:52.03,1:32:53.66,*Default,,0,0,0,,他们到了
Dialogue: 0,1:33:02.99,1:33:04.62,*Default,,0,0,0,,是那个人
Dialogue: 0,1:33:15.87,1:33:17.34,*Default,,0,0,0,,武田观柳!
Dialogue: 0,1:33:24.15,1:33:28.10,*Default,,0,0,0,,喂,我免费把你们都打飞!
Dialogue: 0,1:33:28.67,1:33:30.06,*Default,,0,0,0,,快点给我过来!
Dialogue: 0,1:34:31.23,1:34:32.74,*Default,,0,0,0,,绯村拔刀斋!
Dialogue: 0,1:34:35.35,1:34:36.49,*Default,,0,0,0,,熏小姐
Dialogue: 0,1:34:38.75,1:34:40.66,*Default,,0,0,0,,擅自闯入私家地盘
Dialogue: 0,1:34:41.07,1:34:42.90,*Default,,0,0,0,,不懂礼貌么?
Dialogue: 0,1:34:43.07,1:34:44.86,*Default,,0,0,0,,你在说什么啊?!
Dialogue: 0,1:34:44.99,1:34:47.14,*Default,,0,0,0,,不必顾虑
Dialogue: 0,1:34:47.83,1:34:48.70,*Default,,0,0,0,,给我杀!
Dialogue: 0,1:34:51.11,1:34:52.82,*Default,,0,0,0,,给我杀!
Dialogue: 0,1:35:01.63,1:35:05.25,*Default,,0,0,0,,杀,我有大把钱!
Dialogue: 0,1:35:07.59,1:35:09.14,*Default,,0,0,0,,看,钱啊!
Dialogue: 0,1:35:11.27,1:35:14.74,*Default,,0,0,0,,杀了他们大大有赏
Dialogue: 0,1:35:24.27,1:35:25.58,*Default,,0,0,0,,给我杀!
Dialogue: 0,1:35:39.71,1:35:42.78,*Default,,0,0,0,,我不懂,为什么?
Dialogue: 0,1:35:43.27,1:35:48.78,*Default,,0,0,0,,拔刀斋是为了什么如此拼命,有什么好处?
Dialogue: 0,1:35:48.99,1:35:53.62,*Default,,0,0,0,,如果他是为个人利益,早已当上陆军干部了
Dialogue: 0,1:35:54.15,1:35:57.98,*Default,,0,0,0,,维新志士就是这副德行
Dialogue: 0,1:36:00.91,1:36:02.13,*Default,,0,0,0,,故弄玄虚
Dialogue: 0,1:36:06.27,1:36:07.82,*Default,,0,0,0,,把那个准备好
Dialogue: 0,1:36:09.27,1:36:10.62,*Default,,0,0,0,,那个吗?,可是...
Dialogue: 0,1:36:10.75,1:36:12.06,*Default,,0,0,0,,不许顶嘴!
Dialogue: 0,1:36:12.19,1:36:15.58,*Default,,0,0,0,,慎之又慎,这是做生意的铁律
Dialogue: 0,1:36:15.99,1:36:16.82,*Default,,0,0,0,,是
Dialogue: 0,1:36:18.35,1:36:20.58,*Default,,0,0,0,,把女人带走
Dialogue: 0,1:36:52.91,1:36:55.29,*Default,,0,0,0,,我有一事相求
Dialogue: 0,1:37:47.39,1:37:49.18,*Default,,0,0,0,,那个四眼疯子在哪里?
Dialogue: 0,1:37:49.31,1:37:50.78,*Default,,0,0,0,,大概在上面
Dialogue: 0,1:37:59.27,1:38:00.82,*Default,,0,0,0,,我的对手是哪一个?
Dialogue: 0,1:38:12.63,1:38:14.14,*Default,,0,0,0,,我来当你的对手
Dialogue: 0,1:38:26.27,1:38:30.05,*Default,,0,0,0,,以拳对拳,该我这个打手出场
Dialogue: 0,1:38:30.51,1:38:31.46,*Default,,0,0,0,,你快去!
Dialogue: 0,1:38:31.79,1:38:32.98,*Default,,0,0,0,,不胜感激
Dialogue: 0,1:38:48.99,1:38:51.14,*Default,,0,0,0,,你就是拔刀斋?
Dialogue: 0,1:38:55.47,1:38:56.98,*Default,,0,0,0,,惠小姐在哪里?
Dialogue: 0,1:38:58.31,1:39:01.62,*Default,,0,0,0,,那种女人值得你救么?
Dialogue: 0,1:39:02.31,1:39:04.94,*Default,,0,0,0,,世上没有不值得救之人
Dialogue: 0,1:39:05.27,1:39:07.14,*Default,,0,0,0,,好伟大的理由啊
Dialogue: 0,1:39:08.27,1:39:09.30,*Default,,0,0,0,,倒是你
Dialogue: 0,1:39:10.35,1:39:12.65,*Default,,0,0,0,,为何要向观柳出卖灵魂
Dialogue: 0,1:39:15.11,1:39:16.25,*Default,,0,0,0,,灵魂?
Dialogue: 0,1:39:16.79,1:39:20.33,*Default,,0,0,0,,你也应该曾是有信念的士族
Dialogue: 0,1:39:24.67,1:39:26.78,*Default,,0,0,0,,说什么傻话呢
Dialogue: 0,1:39:44.67,1:39:46.82,*Default,,0,0,0,,因为无处谋生了
Dialogue: 0,1:39:48.19,1:39:51.54,*Default,,0,0,0,,在你们创造的这个敷衍了事的和平时代里
Dialogue: 0,1:40:32.35,1:40:34.10,*Default,,0,0,0,,剑心,没事吧?!
Dialogue: 0,1:40:55.55,1:40:56.22,*Default,,0,0,0,,去死
Dialogue: 0,1:41:25.83,1:41:27.54,*Default,,0,0,0,,这刀是怎么回事?
Dialogue: 0,1:41:34.79,1:41:36.10,*Default,,0,0,0,,不杀之誓
Dialogue: 0,1:41:37.51,1:41:38.94,*Default,,0,0,0,,逆刃刀
Dialogue: 0,1:41:51.91,1:41:53.78,*Default,,0,0,0,,看你往哪儿跑?
Dialogue: 0,1:42:17.31,1:42:20.14,*Default,,0,0,0,,先等等,等等...
Dialogue: 0,1:42:21.83,1:42:23.02,*Default,,0,0,0,,等什么?
Dialogue: 0,1:42:31.35,1:42:33.34,*Default,,0,0,0,,你要吃么,很好吃的
Dialogue: 0,1:42:33.47,1:42:34.34,*Default,,0,0,0,,给
Dialogue: 0,1:42:39.47,1:42:42.50,*Default,,0,0,0,,- 我吃素的  - 可怜啊
Dialogue: 0,1:42:46.03,1:42:47.17,*Default,,0,0,0,,喝点么?
Dialogue: 0,1:42:48.03,1:42:49.01,*Default,,0,0,0,,给我
Dialogue: 0,1:43:25.71,1:43:29.49,*Default,,0,0,0,,斩杀了那么多人的你,现在却用着逆刃刀
Dialogue: 0,1:43:29.87,1:43:30.90,*Default,,0,0,0,,别开玩笑了!
Dialogue: 0,1:44:08.43,1:44:10.26,*Default,,0,0,0,,架是要...
Dialogue: 0,1:44:10.95,1:44:13.25,*Default,,0,0,0,,用头来打的!
Dialogue: 0,1:44:22.23,1:44:23.50,*Default,,0,0,0,,打得真尽兴
Dialogue: 0,1:44:54.59,1:44:57.18,*Default,,0,0,0,,总算动真格的了
Dialogue: 0,1:45:20.87,1:45:23.22,*Default,,0,0,0,,什么不杀之誓
Dialogue: 0,1:45:24.35,1:45:27.18,*Default,,0,0,0,,你以为不杀我能结束这场对战么?
Dialogue: 0,1:45:28.19,1:45:29.33,*Default,,0,0,0,,在下结束给你看
Dialogue: 0,1:45:29.83,1:45:31.05,*Default,,0,0,0,,那就试试看吧!
Dialogue: 0,1:46:12.91,1:46:14.70,*Default,,0,0,0,,真是大干了一场啊
Dialogue: 0,1:46:17.43,1:46:19.22,*Default,,0,0,0,,走吧
Dialogue: 0,1:46:20.71,1:46:21.74,*Default,,0,0,0,,等等
Dialogue: 0,1:46:24.39,1:46:26.74,*Default,,0,0,0,,还没决出胜负
Dialogue: 0,1:46:27.95,1:46:29.26,*Default,,0,0,0,,继续打
Dialogue: 0,1:46:31.11,1:46:33.22,*Default,,0,0,0,,胜负已分
Dialogue: 0,1:47:08.47,1:47:10.18,*Default,,0,0,0,,这东西真厉害啊!
Dialogue: 0,1:47:10.27,1:47:10.98,*Default,,0,0,0,,是
Dialogue: 0,1:47:14.59,1:47:15.54,*Default,,0,0,0,,点烟
Dialogue: 0,1:47:15.63,1:47:16.30,*Default,,0,0,0,,是
Dialogue: 0,1:47:16.47,1:47:17.69,*Default,,0,0,0,,左之助!
Dialogue: 0,1:47:24.51,1:47:27.90,*Default,,0,0,0,,至少让我安心抽根烟啊
Dialogue: 0,1:47:29.19,1:47:31.65,*Default,,0,0,0,,把别人家弄得乱七八糟的!
Dialogue: 0,1:47:31.79,1:47:32.66,*Default,,0,0,0,,这群混蛋!
Dialogue: 0,1:47:32.79,1:47:34.30,*Default,,0,0,0,,弄得乱七八糟的是你这混蛋吧!
Dialogue: 0,1:47:34.39,1:47:36.50,*Default,,0,0,0,,传说中的刽子手在哪里?
Dialogue: 0,1:47:36.75,1:47:38.34,*Default,,0,0,0,,别小看老子!
Dialogue: 0,1:47:39.47,1:47:41.50,*Default,,0,0,0,,要干掉他的话,算我一个
Dialogue: 0,1:47:42.47,1:47:44.26,*Default,,0,0,0,,你为何会来?
Dialogue: 0,1:47:44.71,1:47:47.66,*Default,,0,0,0,,你家那个小鬼跑来找警察求助了
Dialogue: 0,1:47:47.99,1:47:49.26,*Default,,0,0,0,,弥彦吗?
Dialogue: 0,1:47:52.19,1:47:53.30,*Default,,0,0,0,,怎么了?!
Dialogue: 0,1:47:53.67,1:47:54.62,*Default,,0,0,0,,快看
Dialogue: 0,1:47:57.51,1:48:00.34,*Default,,0,0,0,,那把怪物般的枪朝向某个方向的话
Dialogue: 0,1:48:01.11,1:48:02.98,*Default,,0,0,0,,反方向就成了死角
Dialogue: 0,1:48:03.67,1:48:05.34,*Default,,0,0,0,,快出来
Dialogue: 0,1:48:05.47,1:48:08.18,*Default,,0,0,0,,来啊
Dialogue: 0,1:48:08.83,1:48:09.86,*Default,,0,0,0,,怎么了
Dialogue: 0,1:48:10.83,1:48:11.70,*Default,,0,0,0,,我认输!
Dialogue: 0,1:48:12.83,1:48:14.18,*Default,,0,0,0,,我投降
Dialogue: 0,1:48:14.51,1:48:17.22,*Default,,0,0,0,,别开枪
Dialogue: 0,1:48:18.67,1:48:21.18,*Default,,0,0,0,,跟那个东西斗,怎么可能赢
Dialogue: 0,1:48:21.51,1:48:22.86,*Default,,0,0,0,,对吧,剑心?
Dialogue: 0,1:48:23.99,1:48:27.53,*Default,,0,0,0,,你也出来,怎么可能会赢
Dialogue: 0,1:48:34.19,1:48:35.70,*Default,,0,0,0,,在下投降
Dialogue: 0,1:48:43.99,1:48:45.74,*Default,,0,0,0,,把刀放下
Dialogue: 0,1:49:07.11,1:49:09.26,*Default,,0,0,0,,向我谢罪
Dialogue: 0,1:49:09.71,1:49:11.74,*Default,,0,0,0,,朝我跪拜
Dialogue: 0,1:49:13.11,1:49:16.73,*Default,,0,0,0,,不如把衣服脱了,你们俩全脱光
Dialogue: 0,1:49:16.91,1:49:19.94,*Default,,0,0,0,,全脱光再朝我跪拜!
Dialogue: 0,1:49:23.47,1:49:24.94,*Default,,0,0,0,,少给鼻子上脸!
Dialogue: 0,1:49:27.91,1:49:29.42,*Default,,0,0,0,,可恶
Dialogue: 0,1:49:36.59,1:49:37.57,*Default,,0,0,0,,在这儿呢,打啊
Dialogue: 0,1:49:37.75,1:49:38.94,*Default,,0,0,0,,打啊
Dialogue: 0,1:49:40.91,1:49:42.74,*Default,,0,0,0,,多来几发
Dialogue: 0,1:50:03.07,1:50:04.66,*Default,,0,0,0,,可恶!
Dialogue: 0,1:50:17.83,1:50:21.61,*Default,,0,0,0,,知道什么东西用钱买不到么?
Dialogue: 0,1:50:31.43,1:50:33.81,*Default,,0,0,0,,就是你现在乞求的东西
Dialogue: 0,1:50:42.03,1:50:43.30,*Default,,0,0,0,,你的命
Dialogue: 0,1:50:46.83,1:50:47.97,*Default,,0,0,0,,住手!
Dialogue: 0,1:50:54.55,1:50:58.17,*Default,,0,0,0,,总算可以把你揍一顿了
Dialogue: 0,1:51:01.07,1:51:02.13,*Default,,0,0,0,,你干什么?
Dialogue: 0,1:51:02.55,1:51:04.98,*Default,,0,0,0,,归我善后,你们走!
Dialogue: 0,1:51:08.91,1:51:10.02,*Default,,0,0,0,,不胜感激
Dialogue: 0,1:51:27.55,1:51:28.50,*Default,,0,0,0,,惠小姐
Dialogue: 0,1:51:31.55,1:51:33.02,*Default,,0,0,0,,抱歉让你久等了
Dialogue: 0,1:51:33.27,1:51:34.74,*Default,,0,0,0,,已经没事了
Dialogue: 0,1:51:35.55,1:51:37.30,*Default,,0,0,0,,你平安无事,真是万幸
Dialogue: 0,1:51:39.99,1:51:41.86,*Default,,0,0,0,,快去救小薰!
Dialogue: 0,1:52:08.11,1:52:10.10,*Default,,0,0,0,,看来你醒了
Dialogue: 0,1:52:17.31,1:52:19.50,*Default,,0,0,0,,别那样瞪着我
Dialogue: 0,1:52:20.67,1:52:24.10,*Default,,0,0,0,,抓你当人质,就能激怒拔刀斋
Dialogue: 0,1:52:24.91,1:52:29.62,*Default,,0,0,0,,愤怒会让那家伙变回过去的刽子手
Dialogue: 0,1:52:40.35,1:52:42.62,*Default,,0,0,0,,应该就快来了
Dialogue: 0,1:52:55.87,1:52:56.85,*Default,,0,0,0,,剑心!
Dialogue: 0,1:53:12.15,1:53:13.66,*Default,,0,0,0,,怒气冲天呢
Dialogue: 0,1:53:15.11,1:53:17.98,*Default,,0,0,0,,我在为把熏小姐牵连进来的你
Dialogue: 0,1:53:19.87,1:53:23.49,*Default,,0,0,0,,以及没来得及阻止你的自己愤怒
Dialogue: 0,1:53:24.87,1:53:25.98,*Default,,0,0,0,,剑心?
Dialogue: 0,1:53:33.79,1:53:35.86,*Default,,0,0,0,,很好,拔刀斋
Dialogue: 0,1:53:37.11,1:53:38.98,*Default,,0,0,0,,发怒吧
Dialogue: 0,1:53:41.15,1:53:42.29,*Default,,0,0,0,,熏小姐!
Dialogue: 0,1:54:08.99,1:54:11.10,*Default,,0,0,0,,那把刀杀得了我么?
Dialogue: 0,1:54:45.39,1:54:46.37,*Default,,0,0,0,,剑心!
Dialogue: 0,1:54:48.83,1:54:51.34,*Default,,0,0,0,,连这背车刀都估测不到么?
Dialogue: 0,1:55:20.07,1:55:21.10,*Default,,0,0,0,,剑心!
Dialogue: 0,1:55:26.23,1:55:28.34,*Default,,0,0,0,,还不够
Dialogue: 0,1:55:32.27,1:55:37.18,*Default,,0,0,0,,你还远远不及昔日的拔刀斋
Dialogue: 0,1:55:50.15,1:55:51.26,*Default,,0,0,0,,熏小姐!
Dialogue: 0,1:55:51.43,1:55:56.94,*Default,,0,0,0,,我施了强力的心之一方,足以麻痹她的肺
Dialogue: 0,1:56:02.07,1:56:04.10,*Default,,0,0,0,,她最多能撑两分钟
Dialogue: 0,1:56:11.15,1:56:12.21,*Default,,0,0,0,,刃卫
Dialogue: 0,1:56:13.15,1:56:14.46,*Default,,0,0,0,,时间不多了
Dialogue: 0,1:56:15.95,1:56:18.10,*Default,,0,0,0,,有话就用剑说
Dialogue: 0,1:56:25.47,1:56:26.94,*Default,,0,0,0,,名不虚传
Dialogue: 0,1:56:28.79,1:56:30.78,*Default,,0,0,0,,想活命的话
Dialogue: 0,1:56:31.43,1:56:33.86,*Default,,0,0,0,,就给我解开熏小姐身上的心之一方!
Dialogue: 0,1:56:34.19,1:56:36.18,*Default,,0,0,0,,我没法解了
Dialogue: 0,1:56:37.83,1:56:40.13,*Default,,0,0,0,,方法只有两个
Dialogue: 0,1:56:40.51,1:56:42.34,*Default,,0,0,0,,靠自己的力量解开
Dialogue: 0,1:56:43.83,1:56:49.94,*Default,,0,0,0,,或者把施术者杀掉,断绝剑气
Dialogue: 0,1:56:53.87,1:56:54.85,*Default,,0,0,0,,既然如此
Dialogue: 0,1:57:46.91,1:57:51.06,*Default,,0,0,0,,这是生死之战,绯村拔刀斋
Dialogue: 0,1:58:08.91,1:58:10.42,*Default,,0,0,0,,游戏到此为止
Dialogue: 0,1:58:17.59,1:58:20.46,*Default,,0,0,0,,我要杀了你,放马过来
Dialogue: 0,1:58:49.59,1:58:50.90,*Default,,0,0,0,,接招!
Dialogue: 0,1:59:28.19,1:59:31.18,*Default,,0,0,0,,这就是拔刀术的架势么?
Dialogue: 0,1:59:57.51,2:00:02.02,*Default,,0,0,0,,飞天御剑流拔刀术,双龙闪
Dialogue: 0,2:00:04.55,2:00:07.38,*Default,,0,0,0,,你的手关节已碎,筋骨已断
Dialogue: 0,2:00:08.23,2:00:11.34,*Default,,0,0,0,,你将无法再挥剑
Dialogue: 0,2:00:15.03,2:00:16.06,*Default,,0,0,0,,现在
Dialogue: 0,2:00:19.71,2:00:21.54,*Default,,0,0,0,,你的性命也...
Dialogue: 0,2:00:30.07,2:00:31.98,*Default,,0,0,0,,为了保护熏小姐
Dialogue: 0,2:00:35.35,2:00:37.70,*Default,,0,0,0,,我要再做一次刽子手
Dialogue: 0,2:00:41.23,2:00:42.58,*Default,,0,0,0,,杀
Dialogue: 0,2:00:43.59,2:00:44.42,*Default,,0,0,0,,死吧
Dialogue: 0,2:00:45.71,2:00:47.26,*Default,,0,0,0,,剑心,住手!
Dialogue: 0,2:00:59.55,2:01:01.50,*Default,,0,0,0,,居然解开了
Dialogue: 0,2:01:03.39,2:01:04.61,*Default,,0,0,0,,熏小姐
Dialogue: 0,2:01:07.19,2:01:10.73,*Default,,0,0,0,,请不要变回刽子手
Dialogue: 0,2:01:14.47,2:01:16.77,*Default,,0,0,0,,别再杀戮
Dialogue: 0,2:01:21.47,2:01:22.78,*Default,,0,0,0,,别再杀戮
Dialogue: 0,2:01:24.59,2:01:25.62,*Default,,0,0,0,,剑心
Dialogue: 0,2:01:30.31,2:01:31.37,*Default,,0,0,0,,为了那些
Dialogue: 0,2:01:35.71,2:01:38.46,*Default,,0,0,0,,死在你手上的人
Dialogue: 0,2:01:42.83,2:01:44.10,*Default,,0,0,0,,为了那些
Dialogue: 0,2:01:47.51,2:01:48.65,*Default,,0,0,0,,你救过的人
Dialogue: 0,2:01:50.63,2:01:52.74,*Default,,0,0,0,,为了那些过去的人
Dialogue: 0,2:01:58.07,2:01:59.74,*Default,,0,0,0,,就算不杀人
Dialogue: 0,2:02:04.31,2:02:07.46,*Default,,0,0,0,,你也能救人
Dialogue: 0,2:02:09.51,2:02:10.49,*Default,,0,0,0,,那不就是
Dialogue: 0,2:02:15.59,2:02:16.62,*Default,,0,0,0,,你...
Dialogue: 0,2:02:20.87,2:02:26.66,*Default,,0,0,0,,剑心所向往的新世界么?
Dialogue: 0,2:02:42.79,2:02:44.18,*Default,,0,0,0,,熏小姐
Dialogue: 0,2:02:49.55,2:02:55.38,*Default,,0,0,0,,来个了断吧,拔刀斋
Dialogue: 0,2:03:00.51,2:03:01.73,*Default,,0,0,0,,算了吧
Dialogue: 0,2:03:02.75,2:03:05.86,*Default,,0,0,0,,只能用你的左手,你毫无胜算
Dialogue: 0,2:03:09.39,2:03:11.58,*Default,,0,0,0,,还没结束呢
Dialogue: 0,2:03:22.87,2:03:25.90,*Default,,0,0,0,,你天生就是刽子手
Dialogue: 0,2:03:26.59,2:03:30.13,*Default,,0,0,0,,我知道,是因我也是刽子手
Dialogue: 0,2:03:32.23,2:03:34.69,*Default,,0,0,0,,刽子手终究是刽子手
Dialogue: 0,2:03:37.23,2:03:41.34,*Default,,0,0,0,,我倒要在地狱看看
Dialogue: 0,2:03:42.15,2:03:44.82,*Default,,0,0,0,,你能以浪客自欺欺人多久
Dialogue: 0,2:04:43.79,2:04:44.98,*Default,,0,0,0,,体会到了么
Dialogue: 0,2:04:46.51,2:04:49.98,*Default,,0,0,0,,自称不杀人的浪客
Dialogue: 0,2:04:50.91,2:04:54.78,*Default,,0,0,0,,声张这种虚伪的正义,会有什么后果
Dialogue: 0,2:04:57.15,2:05:00.34,*Default,,0,0,0,,杀人会滋生仇恨
Dialogue: 0,2:05:01.83,2:05:04.13,*Default,,0,0,0,,仇恨又会驱使人去杀人
Dialogue: 0,2:05:05.99,2:05:08.34,*Default,,0,0,0,,断绝这层因果循环
Dialogue: 0,2:05:10.03,2:05:13.46,*Default,,0,0,0,,便是这把逆刃刀的使命
Dialogue: 0,2:05:17.99,2:05:20.55,*Default,,0,0,0,,你要说那种冠冕堂皇的话到什么时候?
Dialogue: 0,2:05:32.87,2:05:34.66,*Default,,0,0,0,,又要继续流浪之旅么?
Dialogue: 0,2:05:38.23,2:05:41.06,*Default,,0,0,0,,浪客不过是弱者的逃避途径
Dialogue: 0,2:05:47.51,2:05:49.38,*Default,,0,0,0,,仗剑生,为剑死
Dialogue: 0,2:05:52.03,2:05:54.90,*Default,,0,0,0,,这是我们唯一的路
Dialogue: 0,2:06:10.71,2:06:13.17,*Default,,0,0,0,,发现大量走私品
Dialogue: 0,2:06:14.03,2:06:17.65,*Default,,0,0,0,,一个也别放过!
Dialogue: 0,2:06:25.23,2:06:27.14,*Default,,0,0,0,,就这么带我去港口吧?
Dialogue: 0,2:06:27.27,2:06:30.70,*Default,,0,0,0,,成功逃走的话,我会给你厚赏
Dialogue: 0,2:06:35.95,2:06:36.93,*Default,,0,0,0,,钱在我口袋里
Dialogue: 0,2:06:37.07,2:06:38.10,*Default,,0,0,0,,钱在这边的口袋里
Dialogue: 0,2:06:38.23,2:06:39.74,*Default,,0,0,0,,钱就在这边的口袋里
Dialogue: 0,2:06:39.87,2:06:40.78,*Default,,0,0,0,,我说了我有钱!
Dialogue: 0,2:06:40.91,2:06:42.86,*Default,,0,0,0,,至少让我把鞋穿上吧?
Dialogue: 0,2:06:42.95,2:06:43.46,*Default,,0,0,0,,闭嘴!
Dialogue: 0,2:06:43.59,2:06:45.74,*Default,,0,0,0,,没鞋走路困难啊
Dialogue: 0,2:06:45.91,2:06:48.62,*Default,,0,0,0,,我会回来的!
Dialogue: 0,2:07:54.99,2:07:55.66,*Default,,0,0,0,,剑心!
Dialogue: 0,2:07:56.47,2:07:57.50,*Default,,0,0,0,,你醒了?
Dialogue: 0,2:07:58.19,2:07:59.30,*Default,,0,0,0,,剑心!
Dialogue: 0,2:07:59.95,2:08:00.70,*Default,,0,0,0,,剑心在哪里?
Dialogue: 0,2:08:02.19,2:08:03.30,*Default,,0,0,0,,这个...
Dialogue: 0,2:08:03.51,2:08:05.18,*Default,,0,0,0,,怎么会!
Dialogue: 0,2:08:07.71,2:08:09.54,*Default,,0,0,0,,等一下!
Dialogue: 0,2:08:26.19,2:08:27.22,*Default,,0,0,0,,剑心
Dialogue: 0,2:08:27.79,2:08:29.98,*Default,,0,0,0,,你终于醒了,熏小姐?
Dialogue: 0,2:08:30.39,2:08:32.62,*Default,,0,0,0,,听我们把话说完啦!
Dialogue: 0,2:08:33.03,2:08:36.18,*Default,,0,0,0,,今天晚饭是剑心下厨哦
Dialogue: 0,2:08:36.35,2:08:38.46,*Default,,0,0,0,,肚子饿了
Dialogue: 0,2:09:06.51,2:09:09.50,*Default,,0,0,0,,欢迎回来,剑心
Dialogue: 0,2:09:15.23,2:09:17.10,*Default,,0,0,0,,在下回来了
