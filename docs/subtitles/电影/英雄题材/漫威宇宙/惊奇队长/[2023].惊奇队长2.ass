Dialogue: 0,0:51:08.85,0:51:09.85,Default,,0,0,0,,进来\N{\fs14\1c&H41A9C2&}Now.{\r}
Dialogue: 0,0:51:10.43,0:51:11.43,Default,,0,0,0,,进来\N{\fs14\1c&H41A9C2&}Now.{\r}
Dialogue: 0,0:51:11.85,0:51:12.68,Default,,0,0,0,,进来\N{\fs14\1c&H41A9C2&}Now.{\r}
Dialogue: 0,0:51:13.10,0:51:14.10,Default,,0,0,0,,一 二 三\N{\fs14\1c&H41A9C2&}One, two, three!{\r}
