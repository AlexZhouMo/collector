Dialogue: 0,0:33:10.62,0:33:12.63,*Default,NTP,0,0,0,,(格林童话)
Dialogue: 0,0:34:24.87,0:34:26.37,*Default,NTP,0,0,0,,(帮帮我们)
Dialogue: 0,0:35:55.59,0:35:57.79,*Default,NTP,0,0,0,,(圣巴塞洛缪医院)
Dialogue: 0,0:36:59.24,0:37:01.45,*Default,NTP,0,0,0,,(白垩)
Dialogue: 0,0:37:04.72,0:37:06.95,*Default,NTP,0,0,0,,(沥青)
Dialogue: 0,0:37:09.22,0:37:11.40,*Default,NTP,0,0,0,,(砖尘)
Dialogue: 0,0:37:14.13,0:37:16.55,*Default,NTP,0,0,0,,(植物)
Dialogue: 0,0:37:26.95,0:37:28.80,*Default,NTP,0,0,0,,
Dialogue: 0,0:39:41.42,0:39:42.01,*Default,NTP,0,0,0,,
Dialogue: 0,0:39:46.93,0:39:47.79,*Default,NTP,0,0,0,,
Dialogue: 0,0:40:12.69,0:40:15.10,*Default,NTP,0,0,0,,
Dialogue: 0,0:40:28.31,0:40:30.30,*Default,NTP,0,0,0,,(快点啊  他们要死了)
Dialogue: 0,0:41:27.94,0:41:31.37,*Default,NTP,0,0,0,,
Dialogue: 0,0:48:29.05,0:48:30.65,*Default,NTP,0,0,0,,
Dialogue: 0,0:48:29.05,0:48:30.65,*Default,NTP,0,0,0,,
