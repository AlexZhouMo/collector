Dialogue: 0,0:13:42.63,0:13:43.85,Default,,0,0,0,,现实\N{\fnCronos Pro Subhead\fs14\1c&H3CF1F3&}Reality.{\r}
Dialogue: 0,0:13:45.37,0:13:46.34,Default,,0,0,0,,力量\N{\fnCronos Pro Subhead\fs14\1c&H3CF1F3&}Power.{\r}
